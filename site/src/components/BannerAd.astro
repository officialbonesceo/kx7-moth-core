---
/**
 * Adsterra display banners (highrevenueformat).
 * Each instance uses a unique atOptions binding so multiple slots do not overwrite each other.
 */
interface Props {
  size: '320x50' | '300x250';
  label?: string;
}
const { size, label = 'Sponsored' } = Astro.props;

const units: Record<string, { key: string; width: number; height: number }> = {
  '320x50': { key: '92a48f230bc2d57e0f1f88966d009054', width: 320, height: 50 },
  '300x250': { key: 'c6d8c050964a59a65e53db7bd5665d8a', width: 300, height: 250 },
};
const u = units[size];
const slotId = `ad_${size.replace('x', '_')}_${Math.random().toString(36).slice(2, 8)}`;
---
<aside class="lc-banner-wrap" data-size={size} aria-label="Advertisement">
  <div class="lc-banner-label">{label}</div>
  <div class="lc-banner-box" id={slotId}></div>
</aside>
<script is:inline define:vars={{ key: u.key, width: u.width, height: u.height, slotId }}>
  (function () {
    var box = document.getElementById(slotId);
    if (!box) return;
    // Isolated options object (do not rely on a single global overwrite)
    var opts = {
      key: key,
      format: 'iframe',
      height: height,
      width: width,
      params: {},
    };
    window.atOptions = opts;
    var s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.highrevenueformat.com/' + key + '/invoke.js';
    s.onerror = function () {
      box.innerHTML =
        '<span style="font-size:0.7rem;opacity:0.5">Ad slot</span>';
    };
    box.appendChild(s);
  })();
</script>
<style>
  .lc-banner-wrap {
    margin: 0.85rem auto;
    padding: 0.45rem 0.5rem 0.6rem;
    border-radius: 12px;
    border: 1px solid rgba(128, 128, 128, 0.18);
    background: rgba(128, 128, 128, 0.04);
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    box-sizing: border-box;
  }
  .lc-banner-label {
    align-self: flex-start;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.45;
    margin-bottom: 0.3rem;
  }
  .lc-banner-box {
    width: 100%;
    max-width: 100%;
    min-height: 50px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lc-banner-box :global(iframe),
  .lc-banner-box :global(div) {
    max-width: 100% !important;
  }
</style>
