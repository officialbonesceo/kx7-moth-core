  window.__lcNativeLoaded = true;
  var s = document.createElement('script');
  s.async = true;
  s.setAttribute('data-cfasync', 'false');
  s.src = 'https://pl31410848.profitableratecpmnetwork.com/042f79cf7de2f184bf9ee546037cccb6/invoke.js';
  document.head.appendChild(s);
})();
</script>
<style>
  .lc-native-wrap {
    margin: 1.25rem 0;
    padding: 0.5rem 0.65rem 0.65rem;
    border-radius: 12px;
    border: 1px solid rgba(128, 128, 128, 0.2);
    background: rgba(128, 128, 128, 0.05);
    overflow: hidden;
  }
  .lc-native-label {
