---
interface Props { page: number; totalPages: number; base: string; }
const { page, totalPages, base } = Astro.props;
const prev = page > 1 ? `${base}${base.includes('?') ? '&' : '?'}page=${page - 1}` : null;
const next = page < totalPages ? `${base}${base.includes('?') ? '&' : '?'}page=${page + 1}` : null;
---
{totalPages > 1 && (
  <div class="pager">
    {prev ? <a href={prev}>← Prev</a> : <span class="disabled">← Prev</span>}
    <span>Page {page} / {totalPages}</span>
    {next ? <a href={next}>Next →</a> : <span class="disabled">Next →</span>}
  </div>
)}
