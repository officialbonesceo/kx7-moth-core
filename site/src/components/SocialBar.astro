---
// Client-hydrated social links from admin settings
---
<div class="social-bar">
  <div class="social-title">Join LaneCash</div>
  <div class="social-links" id="socialLinks">
    <span class="muted" style="font-size:.8rem">Loading…</span>
  </div>
</div>
<script is:inline>
  (async function () {
    const box = document.getElementById('socialLinks');
    if (!box) return;
    const icons = {
      youtube: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22.5 7.2a3 3 0 0 0-2.1-2.1C18.6 4.7 12 4.7 12 4.7s-6.6 0-8.4.4A3 3 0 0 0 1.5 7.2 31 31 0 0 0 1.1 12a31 31 0 0 0 .4 4.8 3 3 0 0 0 2.1 2.1c1.8.4 8.4.4 8.4.4s6.6 0 8.4-.4a3 3 0 0 0 2.1-2.1A31 31 0 0 0 22.9 12a31 31 0 0 0-.4-4.8z"/><path d="M10 15.5v-7l6 3.5-6 3.5z" fill="currentColor" stroke="none"/></svg>',
      tiktok: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14.5 3c.4 2.2 1.7 3.7 3.9 4.2v2.3c-1.4.1-2.7-.3-3.9-1.1v5.4a5.4 5.4 0 1 1-5.4-5.4c.3 0 .6 0 .9.1v2.5a2.9 2.9 0 1 0 2 2.8V3h2.5z"/></svg>',
      instagram: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>',
      facebook: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 8h2.5V5.5H14c-2 0-3.5 1.5-3.5 3.5V11H8v2.5h2.5V20H14v-6.5h2.3L17 11h-3V9c0-.6.4-1 1-1z"/></svg>'
    };
    const labels = { youtube: 'YouTube', tiktok: 'TikTok', instagram: 'Instagram', facebook: 'Facebook' };
    try {
      const r = await fetch('/api/socials');
      const j = await r.json();
      box.innerHTML = Object.keys(labels).map(function (k) {
        var href = j[k] || '#';
        return '<a class="social-chip" href="' + href + '" target="_blank" rel="noopener noreferrer">' +
          (icons[k] || '') + '<span>' + labels[k] + '</span></a>';
      }).join('');
    } catch (e) {
      box.innerHTML = '<span class="muted">Social links unavailable</span>';
    }
  })();
</script>
