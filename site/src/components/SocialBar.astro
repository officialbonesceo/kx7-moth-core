---
import { SOCIAL_HREFS } from '../lib/socials';

const links = [
  { key: 'youtube', name: 'YouTube', href: SOCIAL_HREFS.youtube },
  { key: 'facebook', name: 'Facebook', href: SOCIAL_HREFS.facebook },
  { key: 'tiktok', name: 'TikTok', href: SOCIAL_HREFS.tiktok },
  { key: 'instagram', name: 'Instagram', href: SOCIAL_HREFS.instagram },
  { key: 'telegram', name: 'Telegram', href: SOCIAL_HREFS.telegram },
];
---

<div class="social-bar" id="lcSocialBar">
  <div class="social-title">Follow LaneCash</div>
  <p class="muted" style="font-size:.8rem;margin:0 0 10px">Tips &amp; scam alerts — same brand across platforms</p>
  <div class="social-links" id="socialLinks">
    {
      links.map((l) => (
        <a class="social-chip" href={l.href} target="_blank" rel="noopener noreferrer" data-key={l.key}>
          {l.key === 'youtube' && (
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23 7.5s-.2-1.6-.9-2.3c-.8-.9-1.7-.9-2.1-1C17.2 4 12 4 12 4s-5.2 0-7.9.2c-.5.1-1.3.1-2.1 1C1.2 5.9 1 7.5 1 7.5S.8 9.4.8 11.2v1.6c0 1.9.2 3.7.2 3.7s.2 1.6.9 2.3c.8.9 1.9.9 2.4 1 1.7.2 7.7.2 7.7.2s5.2 0 7.9-.2c.5-.1 1.3-.1 2.1-1 .7-.7.9-2.3.9-2.3s.2-1.9.2-3.7v-1.6c0-1.8-.2-3.7-.2-3.7zM9.8 14.6V8.9l5.6 2.9-5.6 2.8z"/></svg>
          )}
          {l.key === 'facebook' && (
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H7v3h3v7h3v-7h3l1-3h-4v-2c0-.6.4-1 1-1z"/></svg>
          )}
          {l.key === 'tiktok' && (
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.8 5.2c1 1.1 2.3 1.9 3.7 2.1v3c-1.3-.1-2.6-.5-3.7-1.3v6.5a6.5 6.5 0 1 1-6.5-6.5c.4 0 .8 0 1.2.1v3.2a3.4 3.4 0 1 0 2.3 3.2V2h3c0 1.1.1 2.2.4 3.2z"/></svg>
          )}
          {l.key === 'instagram' && (
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
          )}
          {l.key === 'telegram' && (
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9.6 15.6 9.4 19c.3 0 .5-.1.7-.3l1.7-1.6 3.5 2.6c.6.3 1.1.2 1.2-.6l2.2-10.4c.2-.9-.3-1.3-.9-1.1L4.3 11c-.9.3-.9.8-.2 1l3.7 1.2 8.6-5.4c.4-.3.8-.1.5.2"/></svg>
          )}
          <span>{l.name}</span>
        </a>
      ))
    }
  </div>
  <p class="muted" style="font-size:.75rem;margin-top:10px">YouTube: <strong>@only_lanecash</strong></p>
</div>

<script is:inline>
  (async function () {
    try {
      var r = await fetch('/api/socials');
      var j = await r.json();
      var box = document.getElementById('socialLinks');
      if (!box || !j) return;
      box.querySelectorAll('a[data-key]').forEach(function (a) {
        var k = a.getAttribute('data-key');
        if (k && j[k] && String(j[k]).indexOf('http') === 0) a.setAttribute('href', j[k]);
      });
    } catch (e) {}
  })();
</script>
