---
<div class="social-bar">
  <div class="social-title">Join LaneCash</div>
  <div class="social-links" id="socialLinks">
    <span class="muted" style="font-size:.8rem">Loading…</span>
  </div>
</div>
<script is:inline>
  (async function () {
    const box = document.getElementById('socialLinks');
    if (!box) return;
    const labels = {
      telegram: 'Telegram',
      youtube: 'YouTube',
      tiktok: 'TikTok',
      instagram: 'Instagram',
      facebook: 'Facebook',
    };
    try {
      const r = await fetch('/api/socials');
      const j = await r.json();
      box.innerHTML = Object.keys(labels).map(function (k) {
        var href = j[k] || '#';
        return '<a class="social-chip" href="' + href + '" target="_blank" rel="noopener noreferrer"><span>' + labels[k] + '</span></a>';
      }).join('');
    } catch (e) {
      box.innerHTML = '<span class="muted">Social links unavailable</span>';
    }
  })();
</script>
