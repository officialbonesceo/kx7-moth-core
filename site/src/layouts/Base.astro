---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title = 'LaneCash — Stay Sharp. Get Ahead.',
  description = 'Practical finance, crypto, side hustles and scam alerts for Nigeria. Clear steps, real costs, no hype.',
  canonical,
  image,
  type = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;
const path = Astro.url.pathname;
const origin = Astro.url.origin;
const canonicalUrl = canonical || `${origin}${path}`;
const ogImage = image || `${origin}/og-default.svg`;
const defaultLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'LaneCash',
  url: origin,
  description,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${origin}/search?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
const ld = jsonLd || defaultLd;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:site_name" content="LaneCash" />
    <meta property="og:locale" content="en_NG" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script is:inline>
      window.LC = {
        toast(msg){
          const t=document.getElementById('toast');
          if(!t) return;
          t.textContent=msg; t.style.display='block';
          setTimeout(()=>t.style.display='none',1800);
        },
        get(k,d){try{const v=JSON.parse(localStorage.getItem(k)||'null'); return v==null?d:v;}catch{return d}},
        set(k,v){try{localStorage.setItem(k, JSON.stringify(v))}catch{}},
        track(path, event){
          const ev=this.get('lc_events',[]); ev.push({path,event,ts:Date.now()}); this.set('lc_events', ev.slice(-200));
          const counts=this.get('lc_interest',{}); counts[path]=(counts[path]||0)+1; this.set('lc_interest', counts);
        },
        beacon(type){
          try{
            const body=JSON.stringify({type});
            if(navigator.sendBeacon) navigator.sendBeacon('/api/beacon', new Blob([body],{type:'application/json'}));
            else fetch('/api/beacon',{method:'POST',headers:{'content-type':'application/json'},body,keepalive:true});
          }catch{}
        }
      };
    </script>
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="/">
          <span class="brand-mark">L</span>
          <span>Lane<b>Cash</b></span>
        </a>
        <div class="top-actions">
          <a href="/search" aria-label="Search" class="icon-link">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
          </a>
          <a href="/notifications" aria-label="Alerts" class="icon-link">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10 21a2 2 0 0 0 4 0"/></svg>
          </a>
        </div>
      </div>
    </header>

    <main class="wrap">
      <slot />
      <div class="footer-note">
        <a href="/about">About</a> · <a href="/disclaimer">Disclaimer</a> · LaneCash
      </div>
    </main>

    <nav class="bottom-nav" aria-label="Primary">
      <div class="bottom-nav-inner">
        <a class={`bnav ${path === '/' ? 'active' : ''}`} href="/">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11.5 12 4l9 7.5"/><path d="M5 10.5V20h14v-9.5"/></svg>
          <span>Home</span>
        </a>
        <a class={`bnav ${path.startsWith('/tools') || path.startsWith('/category') ? 'active' : ''}`} href="/tools">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/></svg>
          <span>Explore</span>
        </a>
        <a class={`bnav ${path.startsWith('/saved') ? 'active' : ''}`} href="/saved">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3h10a1 1 0 0 1 1 1v17l-6-3.5L6 21V4a1 1 0 0 1 1-1z"/></svg>
          <span>Saved</span>
        </a>
        <a class={`bnav ${path.startsWith('/profile') ? 'active' : ''}`} href="/profile">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c1.5-3.5 4.5-5 8-5s6.5 1.5 8 5"/></svg>
          <span>Profile</span>
        </a>
      </div>
    </nav>

    <div class="toast" id="toast"></div>
    <script is:inline>
      (function(){
        const day=new Date().toISOString().slice(0,10);
        if(window.LC.get('lc_visit_day','')!==day){ window.LC.set('lc_visit_day', day); window.LC.beacon('visit'); }
        window.LC.beacon('pageview');
        if('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(function(){});
      })();
    </script>
  </body>
</html>
