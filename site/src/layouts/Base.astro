---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title = 'LaneCash', description = 'Practical money tips, side hustles and opportunities.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100" style="font-family: 'DM Sans', system-ui, sans-serif;">
    <header class="border-b border-slate-800 bg-slate-950/95 sticky top-0 z-40">
      <div class="max-w-5xl mx-auto px-4 h-14 flex items-center justify-between">
        <a href="/" class="font-extrabold tracking-tight text-emerald-400 text-lg">LaneCash</a>
        <nav class="flex gap-4 text-sm text-slate-300">
          <a href="/category/money" class="hover:text-white">Money</a>
          <a href="/category/opportunities" class="hover:text-white">Opportunities</a>
          <a href="/category/scams" class="hover:text-white">Scams</a>
          <a href="/category/guides" class="hover:text-white">Guides</a>
        </nav>
      </div>
    </header>
    <main class="max-w-5xl mx-auto px-4 py-8">
      <slot />
    </main>
    <footer class="border-t border-slate-800 mt-16 py-8 text-center text-slate-500 text-sm">
      LaneCash — Practical money, honestly explained.
    </footer>
  </body>
</html>
