---
import '../styles/global.css';
interface Props { title?: string; description?: string }
const { title = 'LaneCash', description = 'Finance, crypto & practical side hustles.' } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="topbar">
      <div class="wrap topbar-inner">
        <a class="brand" href="/">
          <span class="brand-mark">L</span>
          <span>
            Lane<b>Cash</b>
            <small>FINANCE · INVEST · GROW</small>
          </span>
        </a>
        <nav class="nav">
          <a class={path === '/' ? 'active' : ''} href="/">Home</a>
          <a href="/category/money">Money</a>
          <a href="/category/opportunities">Crypto</a>
          <a href="/category/guides">Guides</a>
          <a href="/category/scams">Scams</a>
        </nav>
      </div>
    </header>
    <main class="wrap main">
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap">LaneCash — practical money, crypto & hustles. No hype.</div>
    </footer>
  </body>
</html>
