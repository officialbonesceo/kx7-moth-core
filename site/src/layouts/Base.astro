---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title = 'LaneCash', description = 'Practical money tips, side hustles and opportunities.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,500;6..72,700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="page-bg"></div>
    <header class="topbar">
      <div class="wrap topbar-inner">
        <a href="/" class="logo">Lane<span>Cash</span></a>
        <nav class="nav">
          <a href="/category/money">Money</a>
          <a href="/category/opportunities">Opps</a>
          <a href="/category/scams">Scams</a>
          <a href="/category/guides">Guides</a>
        </nav>
      </div>
    </header>
    <main class="wrap main">
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap">LaneCash — practical money, honestly explained.</div>
    </footer>
  </body>
</html>
