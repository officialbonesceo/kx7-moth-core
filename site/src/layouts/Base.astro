---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title = 'Xenvest — Check the offer before you pay',
  description = 'Nigeria-first scam alerts, safe money habits, and practical phone skills. Educational only.',
  canonical,
  image,
  type = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;
const path = Astro.url.pathname;
// Domain-safe: always current host (works if domain changes)
const origin = Astro.url.origin;
const canonicalUrl = canonical || `${origin}${path === '/' ? '/' : path}`;
const ogImage = image || `${origin}/og-default.svg`;
const rssUrl = `${origin}/rss.xml`;
const year = new Date().getFullYear();
const defaultLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Xenvest',
  url: origin,
  description,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${origin}/search?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
const ld = jsonLd || defaultLd;

let verifyHtml = '';
const db = Astro.locals.runtime?.env?.DB;
if (db) {
  try {
    const keys = ['verify_google_meta', 'verify_bing_meta', 'verify_yandex_meta', 'verify_extra_head'] as const;
    for (const key of keys) {
      const row = await db.prepare(`SELECT value FROM settings WHERE key = ?`).bind(key).first();
      const raw = row?.value ? String(row.value).trim() : '';
      if (!raw) continue;
      if (key === 'verify_extra_head') {
        verifyHtml += raw + '\n';
        continue;
      }
      if (/<meta/i.test(raw)) {
        verifyHtml += raw + '\n';
      } else if (key === 'verify_google_meta') {
        const content = raw.replace(/^google-site-verification=/i, '').replace(/["']/g, '');
        verifyHtml += `<meta name="google-site-verification" content="${content}" />\n`;
      } else if (key === 'verify_bing_meta') {
        const content = raw.replace(/^msvalidate\.01=/i, '').replace(/["']/g, '');
        verifyHtml += `<meta name="msvalidate.01" content="${content}" />\n`;
      } else if (key === 'verify_yandex_meta') {
        const content = raw.replace(/["']/g, '');
        verifyHtml += `<meta name="yandex-verification" content="${content}" />\n`;
      }
    }
  } catch {}
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0f14" id="metaThemeColor" />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Xenvest RSS" href={rssUrl} />
    <Fragment set:html={verifyHtml} />
    <meta property="og:site_name" content="Xenvest" />
    <meta property="og:locale" content="en_NG" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script is:inline>
      (function(){
        try {
          var pref = localStorage.getItem('lc_theme') || 'system';
          var dark = pref === 'dark' || (pref === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
        // Always current domain — safe if you change custom domain
        try { window.__SITE_ORIGIN__ = window.location.origin; } catch (e) {}
      })();
      window.LC = {
        toast(msg){
          const t=document.getElementById('toast');
          if(!t) return;
          t.textContent=msg; t.style.display='block';
          setTimeout(()=>t.style.display='none',1800);
        },
        get(k,d){try{const v=JSON.parse(localStorage.getItem(k)||'null'); return v==null?d:v;}catch{return d}},
        set(k,v){try{localStorage.setItem(k, JSON.stringify(v))}catch{}},
        origin(){ try { return window.location.origin; } catch { return ''; } },
        deviceId(){
          try {
            var id = localStorage.getItem('lc_device_id');
            if (!id) {
              id = 'd_' + Math.random().toString(36).slice(2) + Date.now().toString(36);
              localStorage.setItem('lc_device_id', id);
            }
            return id;
          } catch { return ''; }
        },
        track(path, event){
          const ev=this.get('lc_events',[]); ev.push({path,event,ts:Date.now()}); this.set('lc_events', ev.slice(-200));
          const counts=this.get('lc_interest',{}); counts[path]=(counts[path]||0)+1; this.set('lc_interest', counts);
        },
        beacon(type){
          try{
            const body=JSON.stringify({type: type, device: this.deviceId()});
            if(navigator.sendBeacon) navigator.sendBeacon('/api/beacon', new Blob([body],{type:'application/json'}));
            else fetch('/api/beacon',{method:'POST',headers:{'content-type':'application/json'},body,keepalive:true});
          }catch{}
        },
        applyTheme(pref){
          pref = pref || localStorage.getItem('lc_theme') || 'system';
          localStorage.setItem('lc_theme', pref);
          var dark = pref === 'dark' || (pref === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
          var meta = document.getElementById('metaThemeColor');
          if (meta) meta.setAttribute('content', dark ? '#0b0f14' : '#f8fafc');
        }
      };
    </script>
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">
            <img src="/logo.svg" alt="" width="34" height="34" />
          </span>
          <span class="brand-name">
            <strong>Xen<b>vest</b></strong>
            <span>Check before you pay</span>
          </span>
        </a>
        <div class="top-actions">
          <button type="button" class="icon-link" id="themeBtn" aria-label="Theme">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
          <a href="/search" aria-label="Search" class="icon-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
          </a>
          <a href="/notifications" aria-label="Alerts" class="icon-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10 21a2 2 0 0 0 4 0"/></svg>
          </a>
        </div>
      </div>
    </header>

    <main class="wrap">
      <slot />

      <footer class="site-footer">
        <div class="site-footer-grid">
          <div>
            <div class="footer-brand">Xen<b>vest</b></div>
            <p class="footer-tag">Scam defence, money habits, and phone skills for Nigeria — educational only.</p>
          </div>
          <div>
            <h4>Explore</h4>
            <a href="/">Home</a>
            <a href="/tools">Tools</a>
            <a href="/search">Search</a>
            <a href="/about">About</a>
          </div>
          <div>
            <h4>More</h4>
            <a href="/disclaimer">Disclaimer</a>
            <a href="/rss.xml">RSS</a>
            <a href="/notifications">Alerts</a>
          </div>
        </div>
        <div class="meziem-foot" aria-label="Studio">
          <span class="meziem-text">© {year} Xenvest · <strong>Meziem</strong></span>
        </div>
      </footer>
    </main>

    <nav class="bottom-nav" aria-label="Primary">
      <div class="bottom-nav-inner">
        <a class={`bnav ${path === '/' ? 'active' : ''}`} href="/">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11.5 12 4l9 7.5"/><path d="M5 10.5V20h14v-9.5"/></svg>
          <span>Home</span>
        </a>
        <a class={`bnav ${path.startsWith('/tools') || path.startsWith('/category') ? 'active' : ''}`} href="/tools">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/></svg>
          <span>Explore</span>
        </a>
        <a class={`bnav ${path.startsWith('/saved') ? 'active' : ''}`} href="/saved">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3h10a1 1 0 0 1 1 1v17l-6-3.5L6 21V4a1 1 0 0 1 1-1z"/></svg>
          <span>Saved</span>
        </a>
        <a class={`bnav ${path.startsWith('/profile') ? 'active' : ''}`} href="/profile">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c1.5-3.5 4.5-5 8-5s6.5 1.5 8 5"/></svg>
          <span>Profile</span>
        </a>
      </div>
    </nav>

    <div class="toast" id="toast"></div>
    <script is:inline>
      (function(){
        var order = ['system','light','dark'];
        window.LC.applyTheme(localStorage.getItem('lc_theme') || 'system');
        document.getElementById('themeBtn')?.addEventListener('click', function(){
          var i = order.indexOf(localStorage.getItem('lc_theme') || 'system');
          var next = order[(i + 1) % order.length];
          window.LC.applyTheme(next);
          window.LC.toast('Theme: ' + next);
        });
        try {
          window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(){
            if ((localStorage.getItem('lc_theme') || 'system') === 'system') window.LC.applyTheme('system');
          });
        } catch (e) {}

        var SIX_H = 6 * 60 * 60 * 1000;
        var lastVisit = Number(localStorage.getItem('lc_visit_at') || 0);
        var now = Date.now();
        if (!lastVisit || now - lastVisit >= SIX_H) {
          localStorage.setItem('lc_visit_at', String(now));
          window.LC.beacon('visit');
        }
        try {
          var pathKey = 'lc_pv_' + location.pathname;
          var lastPv = Number(localStorage.getItem(pathKey) || 0);
          if (!lastPv || now - lastPv >= 30 * 60 * 1000) {
            localStorage.setItem(pathKey, String(now));
            window.LC.beacon('pageview');
          }
        } catch (e) {
          window.LC.beacon('pageview');
        }
        if('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(function(){});
      })();
    </script>
  </body>
</html>
