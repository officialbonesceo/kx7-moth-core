---
import Base from '../layouts/Base.astro';
import SocialBar from '../components/SocialBar.astro';
import { DESK_BLURB } from '../lib/socials';
---
<Base title="About — LaneCash" description="Who publishes LaneCash and how to use the guides." canonical="https://lanecash.name.ng/about">
  <section class="page-hero">
    <h1>About LaneCash</h1>
    <p>Practical money and scam-awareness guides for phones in Nigeria.</p>
  </section>

  <div class="calc-card" style="margin-bottom:12px">
    <h3>Who writes here</h3>
    <p class="muted">{DESK_BLURB}</p>
    <p class="muted" style="margin-top:0.75rem">
      You will see bylines like <strong>LaneCash Editorial</strong>, <strong>Scam Desk</strong>, or <strong>Campus Desk</strong>.
      Those are team labels for this brand — not individual licensed professionals, and not personal identity claims.
    </p>
  </div>

  <div class="calc-card" style="margin-bottom:12px">
    <h3>How to use the site</h3>
    <ul class="muted" style="margin:0;padding-left:1.1rem;line-height:1.55">
      <li>Read a guide, then verify money moves on official apps and bank channels.</li>
      <li>Never pay “activation”, “slot”, or “upgrade” fees to strangers.</li>
      <li>Use Search for a keyword (title/summary only — light load).</li>
      <li>Save articles on this device from Profile / Saved.</li>
    </ul>
  </div>

  <SocialBar />
</Base>
