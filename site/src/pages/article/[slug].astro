---
import Base from '../../layouts/Base.astro';
import SocialBar from '../../components/SocialBar.astro';
import BannerAd from '../../components/BannerAd.astro';
import NewsletterBox from '../../components/NewsletterBox.astro';
import { getArticleBySlug, getRelatedArticles, bumpViews } from '../../lib/db';
import { coverFor, svgCover } from '../../lib/images';
import { teamFor } from '../../lib/socials';

export const prerender = false;

const { slug } = Astro.params;
const db = Astro.locals.runtime?.env?.DB;
let article: any = null;
let related: any[] = [];
try {
  article = slug && db ? await getArticleBySlug(db, slug) : null;
  if (article && db) {
    await bumpViews(db, article.id);
    related = await getRelatedArticles(db, article.slug, article.category, 6);
  }
} catch (e) {
  console.error('[article]', e);
}
if (!article) return Astro.redirect('/');
const cover = coverFor(article);
const coverFb = svgCover(article);
const team = article.author_team || teamFor(article.category, article.title) || 'LaneCash Desk';
const origin = Astro.url.origin;
const pageUrl = `${origin}/article/${article.slug}`;
const shareText = `${article.title} — via LaneCash`;
const rawSource = String(article.source_name || '');
const showSource =
  article.source_url &&
  rawSource &&
  !/ai|openrouter|cloudflare|model|research\s*\(/i.test(rawSource);
const sourceLabel = showSource ? rawSource : 'LaneCash';

function fmtTime(iso?: string) {
  if (!iso) return '';
  try {
    const d = new Date(iso.includes('T') ? iso : iso.replace(' ', 'T') + (iso.endsWith('Z') ? '' : 'Z'));
    if (Number.isNaN(d.getTime())) return String(iso).slice(0, 10);
    return d.toLocaleDateString('en-NG', { day: 'numeric', month: 'short', year: 'numeric' });
  } catch {
    return String(iso).slice(0, 10);
  }
}

const publishedLabel = fmtTime(article.published_at);
const updatedLabel = fmtTime(article.updated_at);
const showUpdated =
  article.updated_at &&
  article.published_at &&
  String(article.updated_at).slice(0, 16) !== String(article.published_at).slice(0, 16);

const WORDS_PER_AD = 160;
const MAX_MID_ADS = 3;
const MIN_WORDS_BEFORE_FIRST = 100;

function wordCount(html: string): number {
  const text = String(html || '')
    .replace(/<[^>]+>/g, ' ')
    .replace(/&[a-z]+;/gi, ' ')
    .replace(/\s+/g, ' ')
    .trim();
  if (!text) return 0;
  return text.split(' ').filter(Boolean).length;
}

type Chunk = { html: string; adAfter?: '320x50' | '300x250' };

function splitByWordBudget(html: string): Chunk[] {
  const raw = String(html || '');
  const total = wordCount(raw);
  if (total < MIN_WORDS_BEFORE_FIRST + 40) return [{ html: raw }];
  const parts = raw.split(/(?=<h2|<h3|<p|<ul|<ol)/i).filter((p) => p && p.trim());
  if (parts.length < 2) return [{ html: raw }];
  const out: Chunk[] = [];
  let buf = '';
  let wordsInBuf = 0;
  let adsPlaced = 0;
  let wordsSinceAd = 0;
  for (let i = 0; i < parts.length; i++) {
    const part = parts[i];
    const w = wordCount(part);
    buf += part;
    wordsInBuf += w;
    wordsSinceAd += w;
    const isLast = i === parts.length - 1;
    const canAd =
      !isLast &&
      adsPlaced < MAX_MID_ADS &&
      wordsInBuf >= MIN_WORDS_BEFORE_FIRST &&
      wordsSinceAd >= WORDS_PER_AD;
    if (canAd || isLast) {
      const size: '320x50' | '300x250' = adsPlaced % 2 === 0 ? '320x50' : '300x250';
      out.push({ html: buf, adAfter: canAd ? size : undefined });
      if (canAd) {
        adsPlaced++;
        wordsSinceAd = 0;
      }
      buf = '';
      wordsInBuf = 0;
    }
  }
  if (buf.trim()) out.push({ html: buf });
  return out.length ? out : [{ html: raw }];
}

const chunks = splitByWordBudget(article.content || '');
const ogImg = cover.startsWith('http') || cover.startsWith('data:') ? cover : `${origin}${cover}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.summary,
  image: cover.startsWith('data:') ? undefined : [ogImg],
  datePublished: article.published_at || undefined,
  dateModified: article.updated_at || article.published_at || undefined,
  author: { '@type': 'Organization', name: team },
  publisher: { '@type': 'Organization', name: 'LaneCash', url: origin },
  mainEntityOfPage: pageUrl,
  articleSection: article.category,
};
---
<Base
  title={`${article.title} — LaneCash`}
  description={article.summary}
  canonical={pageUrl}
  image={cover.startsWith('data:') ? `${origin}/og-default.svg` : ogImg}
  type="article"
  jsonLd={jsonLd}
>
  <a class="chip" href="/" style="margin:8px 0 10px;display:inline-flex">← Back</a>

  <div class="article-hero" id="articleHero" aria-roledescription="carousel">
    <div class="hero-track" id="articleHeroTrack">
      <div class="hero-slide" data-hold="4500">
        <img
          class="hero-img"
          src={cover}
          alt=""
          decoding="async"
          data-fallback={coverFb}
          onerror="this.onerror=null;this.src=this.getAttribute('data-fallback')"
        />
        <div class="hero-grad" style="opacity:.35"></div>
      </div>
      <div class="hero-slide" data-hold="7000">
        <div class="hero-ad-slide" aria-label="Sponsored">
          <BannerAd size="300x250" />
        </div>
      </div>
    </div>
    <div class="hero-dots" id="articleHeroDots"></div>
  </div>

  <div class="article-head">
    <span class={`pill ${article.category}`}>{article.category}</span>
    <h1>{article.title}</h1>
    <p class="summary">{article.summary}</p>
    <div class="author-row">
      <span>
        {team} · {article.reading_minutes || 5} min
        {publishedLabel && <> · <time class="time-stamp" datetime={article.published_at}>{publishedLabel}</time></>}
        {showUpdated && updatedLabel && (
          <> · Updated <time class="time-stamp" datetime={article.updated_at}>{updatedLabel}</time></>
        )}
      </span>
      <button class="save-btn" id="saveBtn" type="button">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 3h10a1 1 0 0 1 1 1v17l-6-3.5L6 21V4a1 1 0 0 1 1-1z"/></svg>
        <span id="saveLabel">Save</span>
      </button>
    </div>
    <span class="source-pill" style="opacity:.85">Source: {sourceLabel}</span>
  </div>

  <div class="share-bar" aria-label="Share this guide">
    <div class="share-title">Share this guide</div>
    <div class="share-actions">
      <a class="share-btn" id="shareWa" target="_blank" rel="noopener noreferrer">WhatsApp</a>
      <a class="share-btn" id="shareTg" target="_blank" rel="noopener noreferrer">Telegram</a>
      <a class="share-btn" id="shareX" target="_blank" rel="noopener noreferrer">X</a>
      <a class="share-btn" id="shareFb" target="_blank" rel="noopener noreferrer">Facebook</a>
      <button class="share-btn" id="shareCopy" type="button">Copy link</button>
      <button class="share-btn" id="shareNative" type="button">More</button>
    </div>
  </div>

  {chunks.map((chunk) => (
    <>
      <article class="prose prose-read">
        <Fragment set:html={chunk.html} />
      </article>
      {chunk.adAfter && (
        <div class="mid-ad-wrap" aria-label="Sponsored">
          <BannerAd size={chunk.adAfter} />
        </div>
      )}
    </>
  ))}

  <div class="mid-ad-wrap" aria-label="Sponsored" style="margin-top:1.25rem">
    <BannerAd size="300x250" />
  </div>

  <NewsletterBox title="Get more guides by email" />
  <SocialBar />

  {related.length > 0 && (
    <section class="related-block" aria-label="Related guides">
      <h2 class="related-title">Related guides</h2>
      <div class="related-list">
        {related.map((r) => (
          <a class="related-card" href={`/article/${r.slug}`}>
            <span class="related-cat">{r.category}</span>
            <span class="related-name">{r.title}</span>
            {r.summary && <span class="related-sum">{r.summary}</span>}
          </a>
        ))}
      </div>
    </section>
  )}

  <div class="share-bar">
    <div class="share-title">Found this useful? Share it</div>
    <div class="share-actions">
      <a class="share-btn" id="shareWa2" target="_blank" rel="noopener noreferrer">WhatsApp</a>
      <a class="share-btn" id="shareTg2" target="_blank" rel="noopener noreferrer">Telegram</a>
      <a class="share-btn" id="shareX2" target="_blank" rel="noopener noreferrer">X</a>
      <button class="share-btn" id="shareCopy2" type="button">Copy link</button>
    </div>
  </div>

  <script is:inline define:vars={{ slug: article.slug, path: `/article/${article.slug}`, title: article.title, summary: article.summary, category: article.category, pageUrl, shareText }}>
    (function(){
      var root = document.getElementById('articleHero');
      if (!root) return;
      var track = document.getElementById('articleHeroTrack');
      var slides = track.querySelectorAll('.hero-slide');
      var n = slides.length;
      var i = 0;
      var timer = null;
      var dots = document.getElementById('articleHeroDots');
      function holdMs(idx){
        var h = slides[idx] && slides[idx].getAttribute('data-hold');
        return h ? Number(h) : 4500;
      }
      function go(idx){
        i = (idx + n) % n;
        track.style.transform = 'translate3d(' + (-i * 100) + '%,0,0)';
        if (dots) dots.querySelectorAll('.hero-dot').forEach(function(d, j){ d.classList.toggle('active', j === i); });
        schedule();
      }
      function schedule(){
        if (timer) clearTimeout(timer);
        timer = setTimeout(function(){ go(i + 1); }, holdMs(i));
      }
      if (dots) {
        for (var d = 0; d < n; d++) {
          var b = document.createElement('button');
          b.type = 'button';
          b.className = 'hero-dot' + (d === 0 ? ' active' : '');
          (function(idx){ b.addEventListener('click', function(){ go(idx); }); })(d);
          dots.appendChild(b);
        }
      }
      var startX = 0, dx = 0;
      root.addEventListener('touchstart', function(e){ startX = e.changedTouches[0].clientX; dx = 0; if (timer) clearTimeout(timer); }, {passive:true});
      root.addEventListener('touchmove', function(e){ dx = e.changedTouches[0].clientX - startX; }, {passive:true});
      root.addEventListener('touchend', function(){ if (Math.abs(dx) > 40) go(i + (dx < 0 ? 1 : -1)); else schedule(); });
      schedule();
    })();

    window.LC?.track(path, 'read');
    const cache = window.LC.get('lc_article_cache', {});
    cache[slug] = { title, summary, category };
    window.LC.set('lc_article_cache', cache);
    const btn = document.getElementById('saveBtn');
    const label = document.getElementById('saveLabel');
    const saved = window.LC.get('lc_saved', []);
    if (saved.includes(slug)) label.textContent = 'Saved';
    btn?.addEventListener('click', () => {
      let s = window.LC.get('lc_saved', []);
      if (s.includes(slug)) { s = s.filter((x) => x !== slug); label.textContent = 'Save'; window.LC.toast('Removed'); }
      else { s.unshift(slug); label.textContent = 'Saved'; window.LC.toast('Saved'); window.LC.beacon('save'); }
      window.LC.set('lc_saved', s.slice(0, 100));
      window.LC.track(path, 'save');
    });
    const text = encodeURIComponent(shareText);
    const url = encodeURIComponent(pageUrl);
    [['shareWa','shareWa2',`https://wa.me/?text=${text}%20${url}`],['shareTg','shareTg2',`https://t.me/share/url?url=${url}&text=${text}`],['shareX','shareX2',`https://twitter.com/intent/tweet?text=${text}&url=${url}`],['shareFb',null,`https://www.facebook.com/sharer/sharer.php?u=${url}`]].forEach(([a,b,href]) => {
      const el = document.getElementById(a); if (el) el.setAttribute('href', href);
      if (b) { const el2 = document.getElementById(b); if (el2) el2.setAttribute('href', href); }
    });
    function copy() { navigator.clipboard?.writeText(pageUrl).then(() => window.LC.toast('Link copied')); }
    document.getElementById('shareCopy')?.addEventListener('click', copy);
    document.getElementById('shareCopy2')?.addEventListener('click', copy);
    document.getElementById('shareNative')?.addEventListener('click', async () => {
      try { if (navigator.share) await navigator.share({ title, text: shareText, url: pageUrl }); else copy(); } catch {}
    });
  </script>
</Base>
