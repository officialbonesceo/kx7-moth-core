---
import Base from '../../layouts/Base.astro';
import SocialBar from '../../components/SocialBar.astro';
import { getArticleBySlug, bumpViews } from '../../lib/db';
import { coverFor } from '../../lib/images';
import { teamFor } from '../../lib/socials';

export const prerender = false;

const { slug } = Astro.params;
const db = Astro.locals.runtime?.env?.DB;
let article: any = null;
try {
  article = (slug && db) ? await getArticleBySlug(db, slug) : null;
  if (article && db) await bumpViews(db, article.id);
} catch (e) {
  console.error('[article]', e);
}
if (!article) return Astro.redirect('/');
const cover = coverFor(article);
const team = article.author_team || teamFor(article.category, article.title);
const origin = Astro.url.origin;
const pageUrl = `${origin}/article/${article.slug}`;
const shareText = `${article.title} — via LaneCash`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.summary,
  image: [cover],
  datePublished: article.published_at || undefined,
  dateModified: article.updated_at || article.published_at || undefined,
  author: { '@type': 'Organization', name: team },
  publisher: { '@type': 'Organization', name: 'LaneCash', url: origin },
  mainEntityOfPage: pageUrl,
  articleSection: article.category,
};
---
<Base
  title={`${article.title} — LaneCash`}
  description={article.summary}
  canonical={pageUrl}
  image={cover}
  type="article"
  jsonLd={jsonLd}
>
  <a class="chip" href="/" style="margin:8px 0 12px;display:inline-flex">← Back</a>
  <img class="article-cover" src={cover} alt={article.title} />
  <div class="article-head">
    <span class={`pill ${article.category}`}>{article.category}</span>
    <h1>{article.title}</h1>
    <p class="summary">{article.summary}</p>
    <div class="author-row">
      <span>{team} · {article.reading_minutes || 8} min read</span>
      <button class="save-btn" id="saveBtn" type="button">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3h10a1 1 0 0 1 1 1v17l-6-3.5L6 21V4a1 1 0 0 1 1-1z"/></svg>
        <span id="saveLabel">Save</span>
      </button>
    </div>
    {article.source_url && (
      <a class="source-pill" href={article.source_url} target="_blank" rel="noopener noreferrer">
        Source: {article.source_name || 'Original'}
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-left:4px"><path d="M7 17L17 7"/><path d="M8 7h9v9"/></svg>
      </a>
    )}
  </div>

  <div class="share-bar" aria-label="Share this guide">
    <div class="share-title">Share this guide</div>
    <div class="share-actions">
      <a class="share-btn wa" id="shareWa" target="_blank" rel="noopener noreferrer">WhatsApp</a>
      <a class="share-btn tg" id="shareTg" target="_blank" rel="noopener noreferrer">Telegram</a>
      <a class="share-btn x" id="shareX" target="_blank" rel="noopener noreferrer">X</a>
      <a class="share-btn fb" id="shareFb" target="_blank" rel="noopener noreferrer">Facebook</a>
      <button class="share-btn copy" id="shareCopy" type="button">Copy link</button>
      <button class="share-btn native" id="shareNative" type="button">More</button>
    </div>
  </div>

  <article class="prose" set:html={article.content} />

  <div class="share-bar" aria-label="Share again">
    <div class="share-title">Found this useful? Share it</div>
    <div class="share-actions">
      <a class="share-btn wa" id="shareWa2" target="_blank" rel="noopener noreferrer">WhatsApp</a>
      <a class="share-btn tg" id="shareTg2" target="_blank" rel="noopener noreferrer">Telegram</a>
      <a class="share-btn x" id="shareX2" target="_blank" rel="noopener noreferrer">X</a>
      <button class="share-btn copy" id="shareCopy2" type="button">Copy link</button>
    </div>
  </div>

  <SocialBar />
  <script is:inline define:vars={{ slug: article.slug, path: `/article/${article.slug}`, title: article.title, summary: article.summary, category: article.category, pageUrl, shareText }}>
    window.LC?.track(path, 'read');
    const cache = window.LC.get('lc_article_cache', {});
    cache[slug] = { title, summary, category };
    window.LC.set('lc_article_cache', cache);

    const btn = document.getElementById('saveBtn');
    const label = document.getElementById('saveLabel');
    const saved = window.LC.get('lc_saved', []);
    if (saved.includes(slug)) label.textContent = 'Saved';
    btn?.addEventListener('click', () => {
      let s = window.LC.get('lc_saved', []);
      if (s.includes(slug)) {
        s = s.filter((x) => x !== slug);
        label.textContent = 'Save';
        window.LC.toast('Removed');
      } else {
        s.unshift(slug);
        label.textContent = 'Saved';
        window.LC.toast('Saved');
        window.LC.beacon('save');
      }
      window.LC.set('lc_saved', s.slice(0, 100));
      window.LC.track(path, 'save');
    });

    const text = encodeURIComponent(shareText);
    const url = encodeURIComponent(pageUrl);
    const wa = 'https://wa.me/?text=' + text + '%20' + url;
    const tg = 'https://t.me/share/url?url=' + url + '&text=' + text;
    const x = 'https://twitter.com/intent/tweet?text=' + text + '&url=' + url;
    const fb = 'https://www.facebook.com/sharer/sharer.php?u=' + url;

    function setHref(id, href) {
      const el = document.getElementById(id);
      if (el) el.setAttribute('href', href);
    }
    setHref('shareWa', wa); setHref('shareWa2', wa);
    setHref('shareTg', tg); setHref('shareTg2', tg);
    setHref('shareX', x); setHref('shareX2', x);
    setHref('shareFb', fb);

    async function copyLink() {
      try {
        await navigator.clipboard.writeText(pageUrl);
        window.LC.toast('Link copied');
      } catch (e) {
        window.LC.toast('Copy failed');
      }
      window.LC.track(path, 'share_copy');
    }
    document.getElementById('shareCopy')?.addEventListener('click', copyLink);
    document.getElementById('shareCopy2')?.addEventListener('click', copyLink);

    document.getElementById('shareNative')?.addEventListener('click', async () => {
      if (navigator.share) {
        try {
          await navigator.share({ title, text: shareText, url: pageUrl });
          window.LC.track(path, 'share_native');
        } catch (e) {}
      } else {
        copyLink();
      }
    });
  </script>
</Base>
