---
import Base from '../../layouts/Base.astro';
import SocialBar from '../../components/SocialBar.astro';
import BannerAd from '../../components/BannerAd.astro';
import NewsletterBox from '../../components/NewsletterBox.astro';
import { getArticleBySlug, getRelatedArticles, bumpViews } from '../../lib/db';
import { coverFor } from '../../lib/images';
import { teamFor } from '../../lib/socials';

export const prerender = false;

const { slug } = Astro.params;
const db = Astro.locals.runtime?.env?.DB;
let article: any = null;
let related: any[] = [];
try {
  article = slug && db ? await getArticleBySlug(db, slug) : null;
  if (article && db) {
    await bumpViews(db, article.id);
    related = await getRelatedArticles(db, article.slug, article.category, 6);
  }
} catch (e) {
  console.error('[article]', e);
}
if (!article) return Astro.redirect('/');
const cover = coverFor(article);
const team = article.author_team || teamFor(article.category, article.title) || 'LaneCash Desk';
const origin = Astro.url.origin;
const pageUrl = `${origin}/article/${article.slug}`;
const shareText = `${article.title} — via LaneCash`;
const rawSource = String(article.source_name || '');
const showSource =
  article.source_url &&
  rawSource &&
  !/ai|openrouter|cloudflare|model|research\s*\(/i.test(rawSource);
const sourceLabel = showSource ? rawSource : 'LaneCash';

const WORDS_PER_AD = 150;
const MAX_MID_ADS = 3;
const MIN_WORDS_BEFORE_FIRST = 100;

function wordCount(html: string): number {
  const text = String(html || '')
    .replace(/<[^>]+>/g, ' ')
    .replace(/&[a-z]+;/gi, ' ')
    .replace(/\s+/g, ' ')
    .trim();
  if (!text) return 0;
  return text.split(' ').filter(Boolean).length;
}

type Chunk = { html: string; adAfter?: '320x50' | '300x250' };

function splitByWordBudget(html: string): Chunk[] {
  const raw = String(html || '');
  const total = wordCount(raw);
  if (total < MIN_WORDS_BEFORE_FIRST + 40) return [{ html: raw }];

  const parts = raw.split(/(?=<h2|<h3|<p|<ul|<ol|<li)/i).filter((p) => p && p.trim());
  if (parts.length < 2) return [{ html: raw }];

  const out: Chunk[] = [];
  let buf = '';
  let wordsInBuf = 0;
  let adsPlaced = 0;
  let wordsSinceAd = 0;

  for (let i = 0; i < parts.length; i++) {
    const part = parts[i];
    const w = wordCount(part);
    buf += part;
    wordsInBuf += w;
    wordsSinceAd += w;

    const isLast = i === parts.length - 1;
    const canAd =
      !isLast &&
      adsPlaced < MAX_MID_ADS &&
      wordsInBuf >= MIN_WORDS_BEFORE_FIRST &&
      wordsSinceAd >= WORDS_PER_AD;

    if (canAd || isLast) {
      const size: '320x50' | '300x250' = adsPlaced % 2 === 0 ? '320x50' : '300x250';
      out.push({
        html: buf,
        adAfter: canAd ? size : undefined,
      });
      if (canAd) {
        adsPlaced++;
        wordsSinceAd = 0;
      }
      buf = '';
      wordsInBuf = 0;
    }
  }

  if (buf.trim()) out.push({ html: buf });
  return out.length ? out : [{ html: raw }];
}

const chunks = splitByWordBudget(article.content || '');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.summary,
  image: [cover],
  datePublished: article.published_at || undefined,
  dateModified: article.updated_at || article.published_at || undefined,
  author: { '@type': 'Organization', name: team },
  publisher: { '@type': 'Organization', name: 'LaneCash', url: origin },
  mainEntityOfPage: pageUrl,
  articleSection: article.category,
};
---
<Base
  title={`${article.title} — LaneCash`}
  description={article.summary}
  canonical={pageUrl}
  image={cover}
  type="article"
  jsonLd={jsonLd}
>
  <a class="chip" href="/" style="margin:8px 0 12px;display:inline-flex">← Back</a>
  <img class="article-cover" src={cover} alt="" />
  <div class="article-head">
    <span class={`pill ${article.category}`}>{article.category}</span>
    <h1>{article.title}</h1>
    <p class="summary">{article.summary}</p>
    <div class="author-row">
      <span>{team} · {article.reading_minutes || 8} min read</span>
      <button class="save-btn" id="saveBtn" type="button">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3h10a1 1 0 0 1 1 1v17l-6-3.5L6 21V4a1 1 0 0 1 1-1z"/></svg>
        <span id="saveLabel">Save</span>
      </button>
    </div>
    <span class="source-pill" style="opacity:.85">Source: {sourceLabel}</span>
  </div>

  <div class="share-bar" aria-label="Share this guide">
    <div class="share-title">Share this guide</div>
    <div class="share-actions">
      <a class="share-btn wa" id="shareWa" target="_blank" rel="noopener noreferrer">WhatsApp</a>
      <a class="share-btn tg" id="shareTg" target="_blank" rel="noopener noreferrer">Telegram</a>
      <a class="share-btn x" id="shareX" target="_blank" rel="noopener noreferrer">X</a>
      <a class="share-btn fb" id="shareFb" target="_blank" rel="noopener noreferrer">Facebook</a>
      <button class="share-btn copy" id="shareCopy" type="button">Copy link</button>
      <button class="share-btn native" id="shareNative" type="button">More</button>
    </div>
  </div>

  {chunks.map((chunk) => (
    <>
      <article class="prose prose-read">
        <Fragment set:html={chunk.html} />
      </article>
      {chunk.adAfter && (
        <div class="mid-ad-wrap" aria-label="Sponsored">
          <BannerAd size={chunk.adAfter} />
        </div>
      )}
    </>
  ))}

  <div class="mid-ad-wrap" aria-label="Sponsored" style="margin-top:1.5rem">
    <BannerAd size="300x250" />
  </div>

  <NewsletterBox title="Get more guides by email" />

  <SocialBar />

  {related.length > 0 && (
    <section class="related-block" aria-label="Related guides">
      <h2 class="related-title">Related guides</h2>
      <div class="related-list">
        {related.map((r) => (
          <a class="related-card" href={`/article/${r.slug}`}>
            <span class="related-cat">{r.category}</span>
            <span class="related-name">{r.title}</span>
            {r.summary && <span class="related-sum">{r.summary}</span>}
          </a>
        ))}
      </div>
    </section>
  )}

  <div class="share-bar" aria-label="Share again">
    <div class="share-title">Found this useful? Share it</div>
    <div class="share-actions">
      <a class="share-btn wa" id="shareWa2" target="_blank" rel="noopener noreferrer">WhatsApp</a>
      <a class="share-btn tg" id="shareTg2" target="_blank" rel="noopener noreferrer">Telegram</a>
      <a class="share-btn x" id="shareX2" target="_blank" rel="noopener noreferrer">X</a>
      <button class="share-btn copy" id="shareCopy2" type="button">Copy link</button>
    </div>
  </div>

  <style>
    .prose-read p {
      margin: 0 0 1.15rem;
      line-height: 1.7;
      font-size: 1.02rem;
    }
    .prose-read h2 {
      margin: 1.75rem 0 0.75rem;
      font-size: 1.2rem;
      line-height: 1.3;
    }
    .prose-read h3 {
      margin: 1.35rem 0 0.55rem;
      font-size: 1.05rem;
    }
    .prose-read ul, .prose-read ol {
      margin: 0 0 1.15rem;
      padding-left: 1.25rem;
      line-height: 1.65;
    }
    .prose-read li { margin: 0.35rem 0; }
    .mid-ad-wrap {
      margin: 1.25rem 0;
      max-height: 280px;
      overflow: hidden;
    }
    .related-block{margin:28px 0 12px}
    .related-title{font-size:1.15rem;font-weight:800;margin:0 0 12px}
    .related-list{display:grid;gap:10px}
    .related-card{display:block;padding:14px;border-radius:14px;border:1px solid rgba(128,128,128,.25);background:rgba(128,128,128,.06);text-decoration:none;color:inherit}
    .related-cat{display:inline-block;font-size:.68rem;font-weight:700;text-transform:uppercase;opacity:.7;margin-bottom:6px}
    .related-name{display:block;font-weight:700;line-height:1.35;margin-bottom:4px}
    .related-sum{display:block;font-size:.85rem;opacity:.75;line-height:1.4}
  </style>
  <script is:inline define:vars={{ slug: article.slug, path: `/article/${article.slug}`, title: article.title, summary: article.summary, category: article.category, pageUrl, shareText }}>
    window.LC?.track(path, 'read');
    const cache = window.LC.get('lc_article_cache', {});
    cache[slug] = { title, summary, category };
    window.LC.set('lc_article_cache', cache);
    const btn = document.getElementById('saveBtn');
    const label = document.getElementById('saveLabel');
    const saved = window.LC.get('lc_saved', []);
    if (saved.includes(slug)) label.textContent = 'Saved';
    btn?.addEventListener('click', () => {
      let s = window.LC.get('lc_saved', []);
      if (s.includes(slug)) {
        s = s.filter((x) => x !== slug);
        label.textContent = 'Save';
        window.LC.toast('Removed');
      } else {
        s.unshift(slug);
        label.textContent = 'Saved';
        window.LC.toast('Saved');
        window.LC.beacon('save');
      }
      window.LC.set('lc_saved', s.slice(0, 100));
      window.LC.track(path, 'save');
    });
    const text = encodeURIComponent(shareText);
    const url = encodeURIComponent(pageUrl);
    const map = [
      ['shareWa', 'shareWa2', `https://wa.me/?text=${text}%20${url}`],
      ['shareTg', 'shareTg2', `https://t.me/share/url?url=${url}&text=${text}`],
      ['shareX', 'shareX2', `https://twitter.com/intent/tweet?text=${text}&url=${url}`],
      ['shareFb', null, `https://www.facebook.com/sharer/sharer.php?u=${url}`],
    ];
    map.forEach(([a, b, href]) => {
      const el = document.getElementById(a);
      if (el) el.setAttribute('href', href);
      if (b) {
        const el2 = document.getElementById(b);
        if (el2) el2.setAttribute('href', href);
      }
    });
    function copy() {
      navigator.clipboard?.writeText(pageUrl).then(() => window.LC.toast('Link copied'));
    }
    document.getElementById('shareCopy')?.addEventListener('click', copy);
    document.getElementById('shareCopy2')?.addEventListener('click', copy);
    document.getElementById('shareNative')?.addEventListener('click', async () => {
      try {
        if (navigator.share) await navigator.share({ title, text: shareText, url: pageUrl });
        else copy();
      } catch {}
    });
  </script>
</Base>
