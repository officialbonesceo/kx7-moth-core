---
/** Admin: manage affiliate keywords → CTA buttons */
export const prerender = false;

const env = Astro.locals.runtime?.env || {};
const ADMIN_EMAIL = String(env.ADMIN_EMAIL || 'officialbonesceo@gmail.com').toLowerCase();
const ADMIN_PASSWORD = String(env.ADMIN_PASSWORD || '');
const db = Astro.locals.runtime?.env?.DB;

let authed = Astro.cookies.get('lc_admin')?.value === '1';
let error = '';
let notice = '';
let rows: any[] = [];
let hints: any[] = [];

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') || '');

  if (action === 'login') {
    const email = String(form.get('email') || '').toLowerCase().trim();
    const password = String(form.get('password') || '');
    if (email === ADMIN_EMAIL && ADMIN_PASSWORD && password === ADMIN_PASSWORD) {
      authed = true;
      Astro.cookies.set('lc_admin', '1', {
        path: '/', httpOnly: true, sameSite: 'lax', secure: true, maxAge: 60 * 60 * 12,
      });
    } else error = 'Invalid login';
  } else if (authed && db) {
    if (action === 'add') {
      const keyword = String(form.get('keyword') || '').trim().toLowerCase();
      const label = String(form.get('label') || '').trim() || keyword;
      const url = String(form.get('url') || '').trim();
      if (keyword && url.startsWith('http')) {
        const id = 'aff_' + keyword.replace(/\s+/g, '_').slice(0, 40);
        await db
          .prepare(
            `INSERT INTO affiliates (id, keyword, label, url, enabled, updated_at)
             VALUES (?, ?, ?, ?, 1, datetime('now'))
             ON CONFLICT(id) DO UPDATE SET label=excluded.label, url=excluded.url, enabled=1, updated_at=datetime('now')`
          )
          .bind(id, keyword, label, url)
          .run();
        notice = 'Saved: ' + keyword;
      } else error = 'Need keyword + full https URL';
    }
    if (action === 'disable') {
      const id = String(form.get('id') || '');
      if (id) {
        await db.prepare(`UPDATE affiliates SET enabled = 0 WHERE id = ?`).bind(id).run();
        notice = 'Disabled';
      }
    }
    if (action === 'enable') {
      const id = String(form.get('id') || '');
      if (id) {
        await db.prepare(`UPDATE affiliates SET enabled = 1 WHERE id = ?`).bind(id).run();
        notice = 'Enabled';
      }
    }
  }
}

if (authed && db) {
  try {
    const r = await db.prepare(`SELECT * FROM affiliates ORDER BY keyword`).all();
    rows = r.results || [];
  } catch {
    rows = [];
  }
  try {
    const h = await db
      .prepare(`SELECT * FROM affiliate_hints ORDER BY seen_count DESC LIMIT 30`)
      .all();
    hints = h.results || [];
  } catch {
    hints = [];
  }
}
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Affiliates — Xenvest Admin</title>
  <style>
    body{margin:0;background:#070707;color:#fff;font-family:system-ui,sans-serif;padding:16px}
    .card{background:#121212;border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:14px;margin:12px 0;max-width:720px}
    input{width:100%;box-sizing:border-box;background:#0a0a0a;border:1px solid rgba(255,255,255,.12);color:#fff;border-radius:10px;padding:10px;margin:6px 0}
    button{background:#22c55e;color:#04140a;border:0;border-radius:10px;padding:10px 14px;font-weight:800;cursor:pointer}
    button.ghost{background:transparent;color:#9ca3af;border:1px solid rgba(255,255,255,.12)}
    a{color:#22c55e}
    table{width:100%;border-collapse:collapse;font-size:.82rem}td,th{padding:8px;border-bottom:1px solid rgba(255,255,255,.08);text-align:left}
    .muted{color:#9ca3af;font-size:.85rem}.err{color:#f87171}.ok{color:#86efac}
  </style>
</head>
<body>
  <p><a href="/bonesceo/admin">← Admin</a></p>
  <h1>Affiliates</h1>
  <p class="muted">Keyword in an article → turns into a button when URL is set. Origin-independent.</p>

  {!authed && (
    <div class="card">
      {error && <p class="err">{error}</p>}
      <form method="POST">
        <input type="hidden" name="action" value="login" />
        <input name="email" type="email" placeholder="Email" required />
        <input name="password" type="password" placeholder="Password" required />
        <button type="submit">Unlock</button>
      </form>
    </div>
  )}

  {authed && (
    <>
      {notice && <p class="ok">{notice}</p>}
      {error && <p class="err">{error}</p>}
      <div class="card">
        <h3>Add / update link</h3>
        <form method="POST">
          <input type="hidden" name="action" value="add" />
          <input name="keyword" placeholder="keyword (e.g. selar)" required />
          <input name="label" placeholder="Button label (e.g. Open on Selar)" />
          <input name="url" type="url" placeholder="https://..." required />
          <button type="submit">Save</button>
        </form>
      </div>

      <div class="card">
        <h3>Active links</h3>
        <table>
          <thead><tr><th>Keyword</th><th>Label</th><th>On</th><th></th></tr></thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td>{r.keyword}</td>
                <td>{r.label}<div class="muted">{r.url}</div></td>
                <td>{Number(r.enabled)===1?'yes':'no'}</td>
                <td>
                  <form method="POST" style="display:inline">
                    <input type="hidden" name="action" value={Number(r.enabled)===1?'disable':'enable'} />
                    <input type="hidden" name="id" value={r.id} />
                    <button type="submit" class="ghost">{Number(r.enabled)===1?'Disable':'Enable'}</button>
                  </form>
                </td>
              </tr>
            ))}
            {rows.length===0 && <tr><td colspan="4" class="muted">None yet — add one above</td></tr>}
          </tbody>
        </table>
      </div>

      <div class="card">
        <h3>Hints (words seen in content)</h3>
        <p class="muted">Auto-logged commercial terms — add a URL above to turn them into buttons.</p>
        <ul class="muted">
          {hints.map((h) => (
            <li><strong>{h.keyword}</strong> ×{h.seen_count} {h.article_slug ? `· ${h.article_slug}` : ''}</li>
          ))}
          {hints.length===0 && <li>No hints yet</li>}
        </ul>
      </div>
    </>
  )}
</body>
</html>
