---
import { adminStats, countArticles } from '../../lib/db';
export const prerender = false;

const env = Astro.locals.runtime?.env || {};
const ADMIN_EMAIL = String(env.ADMIN_EMAIL || 'officialbonesceo@gmail.com').toLowerCase();
const ADMIN_PASSWORD = String(env.ADMIN_PASSWORD || '');
const db = Astro.locals.runtime?.env?.DB;

const section = Astro.url.searchParams.get('s') || 'overview';
const page = Math.max(1, Number(Astro.url.searchParams.get('page') || 1));
const perPage = 15;
const offset = (page - 1) * perPage;
const q = (Astro.url.searchParams.get('q') || '').trim();

let authed = false;
let error = '';
let notice = '';
let stats: any = null;
let posts: any[] = [];
let postTotal = 0;
let socials: Record<string, string> = {
  social_youtube: 'https://youtube.com/@LaneCash',
  social_tiktok: 'https://www.tiktok.com/@lanecash',
  social_instagram: 'https://instagram.com/lanecash',
  social_facebook: 'https://facebook.com/lanecash',
  social_telegram: 'https://t.me/lanecash',
};

async function loadSocials() {
  if (!db) return;
  try {
    for (const key of Object.keys(socials)) {
      const row = await db.prepare(`SELECT value FROM settings WHERE key = ?`).bind(key).first();
      if (row?.value) socials[key] = String(row.value);
    }
  } catch {}
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') || 'login');

  if (action === 'login') {
    const email = String(form.get('email') || '').toLowerCase().trim();
    const password = String(form.get('password') || '');
    if (email === ADMIN_EMAIL && ADMIN_PASSWORD && password === ADMIN_PASSWORD) {
      authed = true;
      Astro.cookies.set('lc_admin', '1', {
        path: '/', httpOnly: true, sameSite: 'lax', secure: true, maxAge: 60 * 60 * 12,
      });
    } else error = 'Invalid login';
  } else if (Astro.cookies.get('lc_admin')?.value === '1') {
    authed = true;
    if (action === 'logout') {
      Astro.cookies.delete('lc_admin', { path: '/' });
      return Astro.redirect('/bonesceo/admin');
    }
    if (action === 'socials' && db) {
      const map: Record<string, string> = {
        social_youtube: String(form.get('social_youtube') || '').trim(),
        social_tiktok: String(form.get('social_tiktok') || '').trim(),
        social_instagram: String(form.get('social_instagram') || '').trim(),
        social_facebook: String(form.get('social_facebook') || '').trim(),
        social_telegram: String(form.get('social_telegram') || '').trim(),
      };
      for (const [key, value] of Object.entries(map)) {
        if (!value) continue;
        await db.prepare(`INSERT INTO settings (key, value) VALUES (?, ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value`).bind(key, value).run();
        socials[key] = value;
      }
      notice = 'Social links saved.';
    }
    if (action === 'unpublish' && db) {
      const id = String(form.get('id') || '');
      if (id) { await db.prepare(`UPDATE articles SET status = 'draft' WHERE id = ?`).bind(id).run(); notice = 'Post unpublished.'; }
    }
    if (action === 'delete' && db) {
      const id = String(form.get('id') || '');
      if (id) { await db.prepare(`DELETE FROM articles WHERE id = ?`).bind(id).run(); notice = 'Post deleted.'; }
    }
    if (action === 'publish' && db) {
      const id = String(form.get('id') || '');
      if (id) { await db.prepare(`UPDATE articles SET status = 'published', updated_at = datetime('now') WHERE id = ?`).bind(id).run(); notice = 'Post published.'; }
    }
    if (action === 'pin' && db) {
      const id = String(form.get('id') || '');
      if (id) { await db.prepare(`UPDATE articles SET is_featured = 1, updated_at = datetime('now') WHERE id = ?`).bind(id).run(); notice = 'Post pinned to hero.'; }
    }
    if (action === 'unpin' && db) {
      const id = String(form.get('id') || '');
      if (id) { await db.prepare(`UPDATE articles SET is_featured = 0, updated_at = datetime('now') WHERE id = ?`).bind(id).run(); notice = 'Post unpinned.'; }
    }
  }
} else if (Astro.cookies.get('lc_admin')?.value === '1') {
  authed = true;
}

if (authed && db) {
  await loadSocials();
  stats = await adminStats(db);
  if (q) {
    const like = `%${q.replace(/[%_]/g, '')}%`;
    try {
      const res = await db.prepare(`SELECT id, slug, title, category, views, author_team, published_at, status, is_featured FROM articles WHERE title LIKE ? OR summary LIKE ? ORDER BY published_at DESC LIMIT ? OFFSET ?`).bind(like, like, perPage, offset).all();
      posts = res.results || [];
      const c = await db.prepare(`SELECT COUNT(*) as c FROM articles WHERE title LIKE ? OR summary LIKE ?`).bind(like, like).first();
      postTotal = Number((c as any)?.c || posts.length);
    } catch { posts = []; postTotal = 0; }
  } else {
    try {
      const res = await db.prepare(`SELECT id, slug, title, category, views, author_team, published_at, status, is_featured FROM articles ORDER BY published_at DESC LIMIT ? OFFSET ?`).bind(perPage, offset).all();
      posts = res.results || [];
      const c = await db.prepare(`SELECT COUNT(*) as c FROM articles`).first();
      postTotal = Number((c as any)?.c || 0);
    } catch { postTotal = await countArticles(db); posts = []; }
  }
}

const totalPages = Math.max(1, Math.ceil(postTotal / perPage));
const prevHref = `/bonesceo/admin?s=posts&page=${page > 1 ? page - 1 : 1}${q ? `&q=${encodeURIComponent(q)}` : ''}`;
const nextHref = `/bonesceo/admin?s=posts&page=${page < totalPages ? page + 1 : totalPages}${q ? `&q=${encodeURIComponent(q)}` : ''}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>LaneCash Admin</title>
  <style>
    :root{--bg:#070707;--panel:#0c0c0c;--card:#121212;--line:rgba(255,255,255,.08);--brand:#22c55e;--muted:#9ca3af;--danger:#f87171}
    *{box-sizing:border-box}body{margin:0;background:var(--bg);color:#fff;font-family:Inter,system-ui,sans-serif;min-height:100vh}
    a{color:var(--brand);text-decoration:none}
    .shell{display:grid;min-height:100vh}@media(min-width:900px){.shell{grid-template-columns:220px 1fr}}
    .side{background:var(--panel);border-bottom:1px solid var(--line);padding:16px}@media(min-width:900px){.side{border-bottom:0;border-right:1px solid var(--line)}}
    .brand{font-weight:800}.brand span{color:var(--brand)}
    .nav a{display:block;padding:10px 12px;border-radius:10px;color:var(--muted);font-weight:700;font-size:.88rem;margin-bottom:4px}
    .nav a.on{background:rgba(34,197,94,.12);color:var(--brand)}
    .main{padding:18px 16px 48px;width:min(1100px,100%)}
    h1{margin:0 0 4px;font-size:1.35rem}.sub{color:var(--muted);margin:0 0 16px;font-size:.85rem}
    .grid{display:grid;gap:10px;grid-template-columns:repeat(2,1fr)}@media(min-width:800px){.grid{grid-template-columns:repeat(4,1fr)}}
    .card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px;margin-bottom:12px}
    .label{color:var(--muted);font-size:.72rem;font-weight:700;text-transform:uppercase}
    .stat{font-size:1.45rem;font-weight:800;margin-top:6px}
    table{width:100%;border-collapse:collapse;font-size:.82rem}th,td{padding:8px 6px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}th{color:var(--muted)}
    input{width:100%;background:#0a0a0a;border:1px solid var(--line);border-radius:10px;color:#fff;padding:11px;margin:6px 0;font:inherit}
    button,.btn{background:var(--brand);color:#04140a;border:0;border-radius:10px;padding:10px 14px;font-weight:800;cursor:pointer;font:inherit;display:inline-block}
    button.ghost{background:transparent;color:var(--muted);border:1px solid var(--line)}
    button.danger{background:transparent;color:var(--danger);border:1px solid rgba(248,113,113,.35)}
    .note{color:var(--muted);font-size:.78rem;margin-top:8px}.ok{color:#86efac}
    .pager{display:flex;justify-content:space-between;margin-top:12px;color:var(--muted);font-size:.85rem}
    .actions{display:flex;flex-wrap:wrap;gap:6px}
    .badge{display:inline-block;padding:2px 8px;border-radius:999px;font-size:.68rem;font-weight:700;background:rgba(34,197,94,.12);color:var(--brand)}
    .badge.draft{background:rgba(251,191,36,.12);color:#fbbf24}
    label.field{display:block;color:var(--muted);font-size:.78rem;margin-top:8px}
  </style>
</head>
<body>
  {!authed && (
    <div class="main" style="margin:0 auto">
      <h1>LaneCash Admin</h1>
      <div class="card" style="max-width:420px">
        {error && <p style="color:var(--danger)">{error}</p>}
        <form method="POST">
          <input type="hidden" name="action" value="login" />
          <label class="field">Email</label>
          <input name="email" type="email" required />
          <label class="field">Password</label>
          <input name="password" type="password" required />
          <button type="submit" style="width:100%;margin-top:10px">Unlock</button>
        </form>
      </div>
    </div>
  )}
  {authed && (
    <div class="shell">
      <aside class="side">
        <div class="brand">Lane<span>Cash</span></div>
        <nav class="nav">
          <a class={section === 'overview' ? 'on' : undefined} href="/bonesceo/admin?s=overview">Overview</a>
          <a class={section === 'posts' ? 'on' : undefined} href="/bonesceo/admin?s=posts">Posts</a>
          <a href="/bonesceo/write">Write</a>
          <a class={section === 'socials' ? 'on' : undefined} href="/bonesceo/admin?s=socials">Socials</a>
          <a class={section === 'push' ? 'on' : undefined} href="/bonesceo/admin?s=push">Push</a>
          <a class={section === 'settings' ? 'on' : undefined} href="/bonesceo/admin?s=settings">Settings</a>
        </nav>
        <form method="POST" style="margin-top:20px"><input type="hidden" name="action" value="logout" /><button type="submit" class="ghost" style="width:100%">Log out</button></form>
      </aside>
      <div class="main">
        {notice && <div class="card ok">{notice}</div>}
        {section === 'overview' && (
          <div>
            <h1>Overview</h1>
            <div class="grid">
              <div class="card"><div class="label">Published</div><div class="stat">{stats?.published ?? 0}</div></div>
              <div class="card"><div class="label">Views</div><div class="stat">{stats?.views ?? 0}</div></div>
              <div class="card"><div class="label">Visitors today</div><div class="stat">{stats?.today?.visitors ?? 0}</div></div>
              <div class="card"><div class="label">Push subs</div><div class="stat">{stats?.subscribers ?? 0}</div></div>
            </div>
            <div class="card"><a class="btn" href="/bonesceo/write">+ Write new article</a></div>
          </div>
        )}
        {section === 'posts' && (
          <div>
            <h1>Posts</h1>
            <p class="sub">{postTotal} total · <a href="/bonesceo/write">+ Write new</a></p>
            <div class="card">
              <form method="GET"><input type="hidden" name="s" value="posts" /><input name="q" value={q} placeholder="Search" /><button type="submit">Search</button></form>
            </div>
            <div class="card" style="overflow-x:auto">
              <table>
                <thead><tr><th>Title</th><th>Status</th><th>Cat</th><th>Views</th><th></th></tr></thead>
                <tbody>
                  {posts.map((r: any) => (
                    <tr>
                      <td><a href={`/article/${r.slug}`} target="_blank">{r.title}</a><div class="note">{String(r.published_at||'').slice(0,10)}</div></td>
                      <td><span class={r.status==='published'?'badge':'badge draft'}>{r.status||'draft'}</span>{Number(r.is_featured)===1 && <span class="badge" style="margin-left:4px">pinned</span>}</td>
                      <td>{r.category}</td>
                      <td>{r.views??0}</td>
                      <td>
                        <div class="actions">
                          <a class="btn" href={`/bonesceo/write?id=${r.id}`} style="padding:8px 10px;font-size:.75rem">Edit</a>
                          <form method="POST"><input type="hidden" name="action" value={Number(r.is_featured)===1?'unpin':'pin'} /><input type="hidden" name="id" value={r.id} /><button type="submit" class="ghost">{Number(r.is_featured)===1?'Unpin':'Pin'}</button></form>
                          <form method="POST"><input type="hidden" name="action" value={r.status==='published'?'unpublish':'publish'} /><input type="hidden" name="id" value={r.id} /><button type="submit" class="ghost">{r.status==='published'?'Unpublish':'Publish'}</button></form>
                          <form method="POST"><input type="hidden" name="action" value="delete" /><input type="hidden" name="id" value={r.id} /><button type="submit" class="danger">Delete</button></form>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <div class="pager">
                {page<=1?<span>Prev</span>:<a href={prevHref}>Prev</a>}
                <span>{page}/{totalPages}</span>
                {page>=totalPages?<span>Next</span>:<a href={nextHref}>Next</a>}
              </div>
            </div>
          </div>
        )}
        {section === 'socials' && (
          <div>
            <h1>Socials</h1>
            <div class="card">
              <form method="POST">
                <input type="hidden" name="action" value="socials" />
                <label class="field">Telegram</label><input name="social_telegram" value={socials.social_telegram} />
                <label class="field">YouTube</label><input name="social_youtube" value={socials.social_youtube} />
                <label class="field">TikTok</label><input name="social_tiktok" value={socials.social_tiktok} />
                <label class="field">Instagram</label><input name="social_instagram" value={socials.social_instagram} />
                <label class="field">Facebook</label><input name="social_facebook" value={socials.social_facebook} />
                <button type="submit" style="margin-top:10px">Save</button>
              </form>
            </div>
          </div>
        )}
        {section === 'push' && (
          <div>
            <h1>Push</h1>
            <div class="card"><a class="btn" href="https://github.com/officialbonesceo/kx7-moth-core/actions/workflows/notify.yml" target="_blank">Notify workflow</a></div>
          </div>
        )}
        {section === 'settings' && (
          <div>
            <h1>Settings</h1>
            <div class="card"><div class="label">Admin email</div><p>{ADMIN_EMAIL}</p></div>
          </div>
        )}
      </div>
    </div>
  )}
</body>
</html>
