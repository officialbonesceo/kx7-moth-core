---
import { adminStats, getArticles, countArticles } from '../../lib/db';
export const prerender = false;

const env = Astro.locals.runtime?.env || {};
const ADMIN_EMAIL = String(env.ADMIN_EMAIL || 'officialbonesceo@gmail.com').toLowerCase();
const ADMIN_PASSWORD = String(env.ADMIN_PASSWORD || '');
const db = Astro.locals.runtime?.env?.DB;

const section = Astro.url.searchParams.get('s') || 'overview';
const page = Math.max(1, Number(Astro.url.searchParams.get('page') || 1));
const perPage = 15;
const offset = (page - 1) * perPage;
const q = (Astro.url.searchParams.get('q') || '').trim();

let authed = false;
let error = '';
let notice = '';
let stats: any = null;
let posts: any[] = [];
let postTotal = 0;
let socials: Record<string, string> = {
  social_youtube: 'https://youtube.com/@LaneCash',
  social_tiktok: 'https://www.tiktok.com/@lanecash',
  social_instagram: 'https://instagram.com/lanecash',
  social_facebook: 'https://facebook.com/lanecash',
  social_telegram: 'https://t.me/lanecash',
};

async function loadSocials() {
  if (!db) return;
  try {
    for (const key of Object.keys(socials)) {
      const row = await db.prepare(`SELECT value FROM settings WHERE key = ?`).bind(key).first();
      if (row?.value) socials[key] = String(row.value);
    }
  } catch {}
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') || 'login');

  if (action === 'login') {
    const email = String(form.get('email') || '').toLowerCase().trim();
    const password = String(form.get('password') || '');
    if (email === ADMIN_EMAIL && ADMIN_PASSWORD && password === ADMIN_PASSWORD) {
      authed = true;
      Astro.cookies.set('lc_admin', '1', {
        path: '/',
        httpOnly: true,
        sameSite: 'lax',
        secure: true,
        maxAge: 60 * 60 * 12,
      });
    } else error = 'Invalid login';
  } else if (Astro.cookies.get('lc_admin')?.value === '1') {
    authed = true;
    if (action === 'logout') {
      Astro.cookies.delete('lc_admin', { path: '/' });
      authed = false;
      return Astro.redirect('/bonesceo/admin');
    }
    if (action === 'socials' && db) {
      const map: Record<string, string> = {
        social_youtube: String(form.get('social_youtube') || '').trim(),
        social_tiktok: String(form.get('social_tiktok') || '').trim(),
        social_instagram: String(form.get('social_instagram') || '').trim(),
        social_facebook: String(form.get('social_facebook') || '').trim(),
        social_telegram: String(form.get('social_telegram') || '').trim(),
      };
      for (const [key, value] of Object.entries(map)) {
        if (!value) continue;
        await db
          .prepare(
            `INSERT INTO settings (key, value) VALUES (?, ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value`
          )
          .bind(key, value)
          .run();
        socials[key] = value;
      }
      notice = 'Social links saved.';
    }
    if (action === 'unpublish' && db) {
      const id = String(form.get('id') || '');
      if (id) {
        await db.prepare(`UPDATE articles SET status = 'draft' WHERE id = ?`).bind(id).run();
        notice = 'Post unpublished.';
      }
    }
    if (action === 'delete' && db) {
      const id = String(form.get('id') || '');
      if (id) {
        await db.prepare(`DELETE FROM articles WHERE id = ?`).bind(id).run();
        notice = 'Post deleted.';
      }
    }
  }
} else if (Astro.cookies.get('lc_admin')?.value === '1') {
  authed = true;
}

if (authed && db) {
  await loadSocials();
  stats = await adminStats(db);
  postTotal = await countArticles(db);
  if (q) {
    const like = `%${q.replace(/[%_]/g, '')}%`;
    const res = await db
      .prepare(
        `SELECT id, slug, title, category, views, author_team, published_at, status FROM articles WHERE title LIKE ? OR summary LIKE ? ORDER BY published_at DESC LIMIT ? OFFSET ?`
      )
      .bind(like, like, perPage, offset)
      .all();
    posts = res.results || [];
    const c = await db
      .prepare(`SELECT COUNT(*) as c FROM articles WHERE title LIKE ? OR summary LIKE ?`)
      .bind(like, like)
      .first<{ c: number }>();
    postTotal = c?.c || posts.length;
  } else {
    const res = await db
      .prepare(
        `SELECT id, slug, title, category, views, author_team, published_at, status FROM articles ORDER BY published_at DESC LIMIT ? OFFSET ?`
      )
      .bind(perPage, offset)
      .all();
    posts = res.results || [];
    const c = await db.prepare(`SELECT COUNT(*) as c FROM articles`).first<{ c: number }>();
    postTotal = c?.c || 0;
  }
}
const totalPages = Math.max(1, Math.ceil(postTotal / perPage));
const nav = [
  { id: 'overview', label: 'Overview' },
  { id: 'posts', label: 'Posts' },
  { id: 'socials', label: 'Socials' },
  { id: 'push', label: 'Push' },
  { id: 'settings', label: 'Settings' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>LaneCash Admin</title>
  <style>
    :root{--bg:#070707;--panel:#0c0c0c;--card:#121212;--line:rgba(255,255,255,.08);--brand:#22c55e;--muted:#9ca3af;--danger:#f87171}
    *{box-sizing:border-box}body{margin:0;background:var(--bg);color:#fff;font-family:Inter,system-ui,sans-serif;min-height:100vh}
    a{color:var(--brand);text-decoration:none}
    .shell{display:grid;min-height:100vh}
    @media(min-width:900px){.shell{grid-template-columns:220px 1fr}}
    .side{background:var(--panel);border-bottom:1px solid var(--line);padding:16px}
    @media(min-width:900px){.side{border-bottom:0;border-right:1px solid var(--line);padding:20px 14px}}
    .brand{font-weight:800;font-size:1.05rem;margin-bottom:4px}.brand span{color:var(--brand)}
    .side .meta{color:var(--muted);font-size:.75rem;margin-bottom:16px}
    .nav a{display:block;padding:10px 12px;border-radius:10px;color:var(--muted);font-weight:700;font-size:.88rem;margin-bottom:4px}
    .nav a.on{background:rgba(34,197,94,.12);color:var(--brand)}
    .main{padding:18px 16px 48px;width:min(1100px,100%)}
    h1{margin:0 0 4px;font-size:1.35rem}.sub{color:var(--muted);margin:0 0 16px;font-size:.85rem}
    .grid{display:grid;gap:10px;grid-template-columns:repeat(2,1fr)}@media(min-width:800px){.grid{grid-template-columns:repeat(4,1fr)}}
    .card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px;margin-bottom:12px}
    .label{color:var(--muted);font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em}
    .stat{font-size:1.45rem;font-weight:800;margin-top:6px}
    table{width:100%;border-collapse:collapse;font-size:.82rem}th{color:var(--muted);font-weight:600;text-align:left;padding:8px 6px;border-bottom:1px solid var(--line)}td{padding:9px 6px;border-bottom:1px solid var(--line);vertical-align:top}
    input,textarea,select{width:100%;background:#0a0a0a;border:1px solid var(--line);border-radius:10px;color:#fff;padding:11px;margin:6px 0;font:inherit}
    textarea{min-height:90px;resize:vertical}
    button,.btn{background:var(--brand);color:#04140a;border:0;border-radius:10px;padding:10px 14px;font-weight:800;cursor:pointer;font:inherit;display:inline-block}
    button.ghost,.btn.ghost{background:transparent;color:var(--muted);border:1px solid var(--line)}
    button.danger{background:transparent;color:var(--danger);border:1px solid rgba(248,113,113,.35)}
    .note{color:var(--muted);font-size:.78rem;margin-top:8px;line-height:1.45}.ok{color:#86efac}
    .pager{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:12px;color:var(--muted);font-size:.85rem}
    .pager .disabled{opacity:.4;pointer-events:none}
    .row2{display:grid;gap:12px}@media(min-width:900px){.row2{grid-template-columns:1fr 1fr}}
    label.field{display:block;color:var(--muted);font-size:.78rem;margin-top:8px}
    .actions{display:flex;flex-wrap:wrap;gap:6px}
    .topbar{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:8px}
    .badge{display:inline-block;padding:2px 8px;border-radius:999px;font-size:.68rem;font-weight:700;background:rgba(34,197,94,.12);color:var(--brand)}
    .badge.draft{background:rgba(251,191,36,.12);color:#fbbf24}
  </style>
</head>
<body>
{!authed ? (
  <div class="main" style="margin:0 auto">
    <h1>LaneCash Admin</h1>
    <p class="sub">Restricted access</p>
    <div class="card" style="max-width:420px">
      {error && <p style="color:var(--danger)">{error}</p>}
      {!ADMIN_PASSWORD && <p style="color:#fbbf24">Set ADMIN_PASSWORD in Cloudflare environment variables.</p>}
      <form method="POST">
        <input type="hidden" name="action" value="login" />
        <label class="field">Email</label>
        <input name="email" type="email" required autocomplete="username" />
        <label class="field">Password</label>
        <input name="password" type="password" required autocomplete="current-password" />
        <button type="submit" style="width:100%;margin-top:10px">Unlock</button>
      </form>
    </div>
  </div>
) : (
  <div class="shell">
    <aside class="side">
      <div class="brand">Lane<span>Cash</span></div>
      <div class="meta">Admin · prod</div>
      <nav class="nav">
        {nav.map((n) => (
          <a class={section === n.id ? 'on' : ''} href={`/bonesceo/admin?s=${n.id}`}>{n.label}</a>
        ))}
      </nav>
      <form method="POST" style="margin-top:20px">
        <input type="hidden" name="action" value="logout" />
        <button type="submit" class="ghost" style="width:100%">Log out</button>
      </form>
      <p class="note" style="margin-top:14px"><a href="/" target="_blank">Open public site ↗</a></p>
    </aside>

    <div class="main">
      {notice && <div class="card ok">{notice}</div>}
      {error && <div class="card" style="color:var(--danger)">{error}</div>}

      {section === 'overview' && (
        <>
          <div class="topbar">
            <div>
              <h1>Overview</h1>
              <p class="sub">Health snapshot · low-read aggregates</p>
            </div>
          </div>
          <div class="grid">
            <div class="card"><div class="label">Published</div><div class="stat">{stats?.published ?? 0}</div></div>
            <div class="card"><div class="label">All rows</div><div class="stat">{stats?.total ?? 0}</div></div>
            <div class="card"><div class="label">Article views</div><div class="stat">{stats?.views ?? 0}</div></div>
            <div class="card"><div class="label">Push subscribers</div><div class="stat">{stats?.subscribers ?? 0}</div></div>
            <div class="card"><div class="label">Today visitors*</div><div class="stat">{stats?.today?.visitors ?? 0}</div></div>
            <div class="card"><div class="label">Today pageviews*</div><div class="stat">{stats?.today?.pageviews ?? 0}</div></div>
            <div class="card"><div class="label">Today saves*</div><div class="stat">{stats?.today?.saves ?? 0}</div></div>
            <div class="card"><div class="label">Pushes today</div><div class="stat">{stats?.today?.pushes ?? 0}</div></div>
          </div>
          <p class="note">* Sampled estimates (low DB writes).</p>
          <div class="row2">
            <div class="card">
              <div class="label">Last 7 days</div>
              <table>
                <tr><th>Day</th><th>Visitors</th><th>Views</th><th>Saves</th></tr>
                {(stats?.last7 || []).map((r: any) => (
                  <tr><td>{r.day}</td><td>{r.visitors}</td><td>{r.pageviews}</td><td>{r.saves}</td></tr>
                ))}
              </table>
            </div>
            <div class="card">
              <div class="label">By category</div>
              <table>
                <tr><th>Category</th><th>Count</th></tr>
                {(stats?.byCat || []).map((r: any) => (
                  <tr><td>{r.category}</td><td>{r.c}</td></tr>
                ))}
              </table>
            </div>
          </div>
          <div class="card">
            <div class="label">Top by views</div>
            <table>
              <tr><th>Title</th><th>Cat</th><th>Views</th></tr>
              {(stats?.top || []).map((r: any) => (
                <tr><td><a href={`/article/${r.slug}`} target="_blank">{r.title}</a></td><td>{r.category}</td><td>{r.views}</td></tr>
              ))}
            </table>
          </div>
        </>
      )}

      {section === 'posts' && (
        <>
          <div class="topbar">
            <div>
              <h1>Posts</h1>
              <p class="sub">{postTotal} total · page {page}/{totalPages}</p>
            </div>
          </div>
          <div class="card">
            <form method="GET">
              <input type="hidden" name="s" value="posts" />
              <input name="q" value={q} placeholder="Search title or summary…" />
              <button type="submit" style="margin-top:6px">Search</button>
            </form>
          </div>
          <div class="card" style="overflow-x:auto">
            <table>
              <tr>
                <th>Title</th>
                <th>Status</th>
                <th>Category</th>
                <th>Views</th>
                <th></th>
              </tr>
              {posts.map((r) => (
                <tr>
                  <td>
                    <a href={`/article/${r.slug}`} target="_blank">{r.title}</a>
                    <div class="note">{r.author_team || ''} · {(r.published_at || '').slice(0, 10)}</div>
                  </td>
                  <td><span class={`badge ${r.status !== 'published' ? 'draft' : ''}`}>{r.status || '—'}</span></td>
                  <td>{r.category}</td>
                  <td>{r.views ?? 0}</td>
                  <td>
                    <div class="actions">
                      {r.status === 'published' && (
                        <form method="POST">
                          <input type="hidden" name="action" value="unpublish" />
                          <input type="hidden" name="id" value={r.id} />
                          <button type="submit" class="ghost">Unpublish</button>
                        </form>
                      )}
                      <form method="POST" onsubmit="return confirm('Delete forever?')">
                        <input type="hidden" name="action" value="delete" />
                        <input type="hidden" name="id" value={r.id} />
                        <button type="submit" class="danger">Delete</button>
                      </form>
                    </div>
                  </td>
                </tr>
              ))}
              {!posts.length && <tr><td colspan="5" class="note">No posts on this page.</td></tr>}
            </table>
            <div class="pager">
              <a class={page <= 1 ? 'disabled' : ''} href={`/bonesceo/admin?s=posts&page=${page - 1}${q ? `&q=${encodeURIComponent(q)}` : ''}`}>← Prev</a>
              <span>Page {page} / {totalPages}</span>
              <a class={page >= totalPages ? 'disabled' : ''} href={`/bonesceo/admin?s=posts&page=${page + 1}${q ? `&q=${encodeURIComponent(q)}` : ''}`}>Next →</a>
            </div>
          </div>
        </>
      )}

      {section === 'socials' && (
        <>
          <h1>Socials</h1>
          <p class="sub">Shown on articles, profile, and about</p>
          <div class="card">
            <form method="POST">
              <input type="hidden" name="action" value="socials" />
              <label class="field">Telegram channel</label>
              <input name="social_telegram" value={socials.social_telegram} placeholder="https://t.me/yourchannel" />
              <label class="field">YouTube</label>
              <input name="social_youtube" value={socials.social_youtube} placeholder="https://youtube.com/@…" />
              <label class="field">TikTok</label>
              <input name="social_tiktok" value={socials.social_tiktok} />
              <label class="field">Instagram</label>
              <input name="social_instagram" value={socials.social_instagram} />
              <label class="field">Facebook</label>
              <input name="social_facebook" value={socials.social_facebook} />
              <button type="submit" style="margin-top:10px">Save social links</button>
            </form>
          </div>
        </>
      )}

      {section === 'push' && (
        <>
          <h1>Push</h1>
          <p class="sub">{stats?.subscribers ?? 0} subscribers · scheduled 3× daily in GitHub Actions</p>
          <div class="card">
            <div class="label">Send now</div>
            <p class="note">Manual send runs from GitHub → Actions → <strong>notify</strong> → Run workflow. Use title, body, and path inputs there. This panel shows status only (keeps secrets off the page).</p>
            <p class="note">Default schedule (UTC): 07:00 · 13:00 · 19:00 (≈ 08:00 / 14:00 / 20:00 WAT)</p>
            <a class="btn" href="https://github.com/officialbonesceo/kx7-moth-core/actions/workflows/notify.yml" target="_blank" rel="noopener">Open notify workflow ↗</a>
          </div>
        </>
      )}

      {section === 'settings' && (
        <>
          <h1>Settings</h1>
          <p class="sub">Access & ops notes</p>
          <div class="card">
            <div class="label">Admin email</div>
            <p style="margin:8px 0;font-weight:700">{ADMIN_EMAIL}</p>
            <p class="note">Password is set only in Cloudflare <code>ADMIN_PASSWORD</code> (never shown here).</p>
          </div>
          <div class="card">
            <div class="label">Launch checklist</div>
            <ul class="note">
              <li>Save real social URLs (especially Telegram)</li>
              <li>Custom domain before heavy ads</li>
              <li>Submit sitemap after domain</li>
              <li>Content via pulse-a every 3 hours</li>
            </ul>
          </div>
        </>
      )}
    </div>
  </div>
)}
</body>
</html>
