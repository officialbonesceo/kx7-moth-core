---
export const prerender = false;
const env = Astro.locals.runtime?.env || {};
const ADMIN_EMAIL = String(env.ADMIN_EMAIL || 'officialbonesceo@gmail.com').toLowerCase();
const ADMIN_PASSWORD = String(env.ADMIN_PASSWORD || '');
const db = Astro.locals.runtime?.env?.DB;

let authed = Astro.cookies.get('lc_admin')?.value === '1';
let error = '';
let notice = '';
let script = '';

if (db) {
  try {
    const row = await db.prepare(`SELECT value FROM settings WHERE key = ?`).bind('ad_monetag_inpage').first();
    if (row?.value) script = String(row.value);
  } catch {}
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') || '');
  if (action === 'login') {
    const email = String(form.get('email') || '').toLowerCase().trim();
    const password = String(form.get('password') || '');
    if (email === ADMIN_EMAIL && ADMIN_PASSWORD && password === ADMIN_PASSWORD) {
      authed = true;
      Astro.cookies.set('lc_admin', '1', {
        path: '/',
        httpOnly: true,
        sameSite: 'lax',
        secure: true,
        maxAge: 60 * 60 * 12,
      });
    } else error = 'Invalid login';
  } else if (authed && action === 'save_ads' && db) {
    const value = String(form.get('ad_monetag_inpage') || '');
    await db
      .prepare(
        `INSERT INTO settings (key, value) VALUES (?, ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value`
      )
      .bind('ad_monetag_inpage', value)
      .run();
    script = value;
    notice = 'Monetag in-page script saved. Public pages load it from /api/ads.';
  } else if (authed && action === 'clear_ads' && db) {
    await db.prepare(`DELETE FROM settings WHERE key = ?`).bind('ad_monetag_inpage').run();
    script = '';
    notice = 'Ad script cleared.';
  }
}
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Ads · LaneCash Admin</title>
  <style>
    body{margin:0;background:#070707;color:#fff;font-family:Inter,system-ui,sans-serif;padding:20px}
    .card{background:#121212;border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:16px;max-width:720px}
    textarea{width:100%;min-height:160px;background:#0a0a0a;border:1px solid rgba(255,255,255,.12);border-radius:10px;color:#fff;padding:12px;font:12px/1.4 ui-monospace,monospace}
    button{background:#22c55e;color:#04140a;border:0;border-radius:10px;padding:10px 14px;font-weight:800;cursor:pointer;margin-right:8px;margin-top:10px}
    button.ghost{background:transparent;color:#9ca3af;border:1px solid rgba(255,255,255,.12)}
    .ok{color:#86efac}.err{color:#f87171}.muted{color:#9ca3af;font-size:.85rem}
    a{color:#22c55e}
    input{width:100%;background:#0a0a0a;border:1px solid rgba(255,255,255,.12);border-radius:10px;color:#fff;padding:11px;margin:6px 0}
  </style>
</head>
<body>
  {!authed ? (
    <div class="card">
      <h1>Ads admin</h1>
      {error && <p class="err">{error}</p>}
      <form method="POST">
        <input type="hidden" name="action" value="login" />
        <label class="muted">Email</label>
        <input name="email" type="email" required />
        <label class="muted">Password</label>
        <input name="password" type="password" required />
        <button type="submit">Unlock</button>
      </form>
      <p class="muted"><a href="/bonesceo/admin">Full admin</a></p>
    </div>
  ) : (
    <div class="card">
      <h1>Monetag · in-page banner</h1>
      <p class="muted">Paste the full in-page / banner script Monetag gives you (usually a script tag). Saved to settings and served at /api/ads for the public site.</p>
      {notice && <p class="ok">{notice}</p>}
      <form method="POST">
        <input type="hidden" name="action" value="save_ads" />
        <textarea name="ad_monetag_inpage" placeholder="&lt;script src=...&gt;&lt;/script&gt;">{script}</textarea>
        <button type="submit">Save script</button>
      </form>
      <form method="POST" style="display:inline">
        <input type="hidden" name="action" value="clear_ads" />
        <button type="submit" class="ghost">Clear</button>
      </form>
      <p class="muted" style="margin-top:14px">
        <a href="/bonesceo/admin">← Admin home</a> ·
        After save, hard-refresh a public article to see the slot load.
      </p>
    </div>
  )}
</body>
</html>
