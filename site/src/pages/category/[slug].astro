---
import Base from '../../layouts/Base.astro';
import { getArticles } from '../../lib/db';

const { slug } = Astro.params;
const db = Astro.locals.runtime?.env?.DB;
let articles: any[] = [];
if (db && slug) {
  const res = await getArticles(db, 30, slug);
  articles = res.results || [];
}
const title = slug ? slug.charAt(0).toUpperCase() + slug.slice(1) : 'Category';
function cover(a: any) {
  if (a.image_url) return a.image_url;
  return `https://source.unsplash.com/1200x675/?${encodeURIComponent((a.category || 'money') + ' finance')}&sig=${encodeURIComponent(a.slug || 'x')}`;
}
---
<Base title={`${title} — LaneCash`}>
  <section class="hero">
    <h1>{title}</h1>
    <p>Practical posts in this section.</p>
  </section>
  <section class="grid">
    {articles.length ? articles.map((a) => (
      <a class="card" href={`/article/${a.slug}`}>
        <img class="card-img" src={cover(a)} alt={a.title} loading="lazy" />
        <div class="card-body">
          <div class="eyebrow">{a.category}</div>
          <h2>{a.title}</h2>
          <p>{a.summary}</p>
        </div>
      </a>
    )) : <div class="empty">No posts yet.</div>}
  </section>
</Base>
