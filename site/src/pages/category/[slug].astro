---
import Base from '../../layouts/Base.astro';
import { getArticles } from '../../lib/db';
const { slug } = Astro.params;
const db = Astro.locals.runtime?.env?.DB;
let articles: any[] = [];
if (db && slug) {
  const res = await getArticles(db, 40, slug);
  articles = res.results || [];
}
const title = slug ? slug.charAt(0).toUpperCase() + slug.slice(1) : 'Category';
function cover(a: any) {
  return a.image_url || `https://image.pollinations.ai/prompt/${encodeURIComponent((a.category||'money')+' finance')}?width=1200&height=675&nologo=true&seed=${encodeURIComponent(a.slug||'x')}`;
}
---
<Base title={`${title} — LaneCash`}>
  <div class="section-head" style="margin-bottom:1.2rem">
    <h2>{title}</h2>
  </div>
  <section class="grid">
    {articles.length ? articles.map((a) => (
      <a class="card" href={`/article/${a.slug}`}>
        <img class="card-img" src={cover(a)} alt={a.title} loading="lazy" />
        <div class="card-body">
          <span class={`pill ${a.category}`}>{a.category}</span>
          <h3>{a.title}</h3>
          <p>{a.summary}</p>
          <div class="card-foot">Read More →</div>
        </div>
      </a>
    )) : <div class="empty">No posts in this category yet.</div>}
  </section>
</Base>
