---
import Base from '../../layouts/Base.astro';
import { getArticles } from '../../lib/db';

const { slug } = Astro.params;
const db = Astro.locals.runtime?.env?.DB;
let articles: any[] = [];
if (db && slug) {
  const res = await getArticles(db, 30, slug);
  articles = res.results || [];
}
const title = slug ? slug.charAt(0).toUpperCase() + slug.slice(1) : 'Category';
---
<Base title={`${title} — LaneCash`}>
  <section class="hero">
    <h1>{title}</h1>
    <p>Latest practical posts in this section.</p>
  </section>
  <section class="grid">
    {articles.length ? articles.map((a) => (
      <a class="card" href={`/article/${a.slug}`}>
        <div class="eyebrow">{a.category}</div>
        <h2>{a.title}</h2>
        <p>{a.summary}</p>
      </a>
    )) : (
      <div class="empty">No posts in this category yet.</div>
    )}
  </section>
</Base>
