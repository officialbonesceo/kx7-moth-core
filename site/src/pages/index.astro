---
import Base from '../layouts/Base.astro';
import { getArticles } from '../lib/db';
import { coverFor } from '../lib/images';

const db = Astro.locals.runtime?.env?.DB;
let articles: any[] = [];
if (db) {
  const res = await getArticles(db, 30);
  articles = res.results || [];
}

const q = Astro.url.searchParams.get('tab') || 'all';
const filtered = q === 'all'
  ? articles
  : articles.filter((a) => {
      const c = (a.category || '').toLowerCase();
      const t = `${a.title} ${a.summary}`.toLowerCase();
      if (q === 'crypto') return c === 'opportunities' || /crypto|usdt|bitcoin|token/.test(t);
      if (q === 'hustles') return c === 'guides' || /hustle|earn|freelance|side/.test(t);
      if (q === 'scams') return c === 'scams' || /scam|fraud|ponzi/.test(t);
      if (q === 'investing') return c === 'money' || /invest|bank|naira|loan/.test(t);
      return true;
    });
---
<Base title="LaneCash — Stay Sharp. Get Ahead.">
  <section class="hero">
    <h1>Stay Sharp. Get Ahead.</h1>
    <p>Finance, crypto & side-hustle insights that pay off.</p>
  </section>

  <div class="chips">
    <a class={`chip ${q === 'all' ? 'active' : ''}`} href="/">★ For You</a>
    <a class={`chip ${q === 'crypto' ? 'active' : ''}`} href="/?tab=crypto">Crypto</a>
    <a class={`chip ${q === 'hustles' ? 'active' : ''}`} href="/?tab=hustles">Daily Hustles</a>
    <a class={`chip ${q === 'scams' ? 'active' : ''}`} href="/?tab=scams">Scam Alerts</a>
    <a class={`chip ${q === 'investing' ? 'active' : ''}`} href="/?tab=investing">Investing</a>
  </div>

  <div class="section-head">
    <h2>Top Picks</h2>
    <a href="/category/money">View all ›</a>
  </div>

  <section class="feed">
    {filtered.length ? filtered.map((a) => (
      <a class="card" href={`/article/${a.slug}`}>
        <div class="card-main">
          <span class={`pill ${a.category}`}>{a.category}</span>
          <h3>{a.title}</h3>
          <p>{a.summary}</p>
          <div class="card-meta">
            <span>LaneCash Desk · {a.reading_minutes || 8} min</span>
            <span>Bookmark</span>
          </div>
        </div>
        <img class="card-thumb" src={coverFor(a)} alt="" loading="lazy" />
      </a>
    )) : (
      <div class="empty">No articles in this tab yet.</div>
    )}
  </section>
</Base>
