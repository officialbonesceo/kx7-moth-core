---
import Base from '../layouts/Base.astro';
import Pagination from '../components/Pagination.astro';
import BannerAd from '../components/BannerAd.astro';
import { getArticles } from '../lib/db';
import { coverFor, svgCover } from '../lib/images';
import { teamFor } from '../lib/socials';

export const prerender = false;

const db = Astro.locals.runtime?.env?.DB;
const tab = Astro.url.searchParams.get('tab') || 'all';
const page = Math.max(1, Number(Astro.url.searchParams.get('page') || 1));
const perPage = 10;
const offset = (page - 1) * perPage;

const isFilterView = tab !== 'all' || page > 1;
const origin = Astro.url.origin;
const cleanHome = `${origin}/`;

let articles: any[] = [];
let total = 0;
let dbError = '';

try {
  if (db) {
    const res = await getArticles(db, 120);
    let all = res.results || [];
    // Dedupe near-identical titles on the feed (unicode quotes etc.)
    const seen = new Set<string>();
    all = all.filter((a) => {
      const k = String(a.title || '')
        .toLowerCase()
        .normalize('NFKC')
        .replace(/[\u2018\u2019]/g, "'")
        .replace(/[\u201c\u201d]/g, '"')
        .replace(/\s+/g, ' ')
        .trim();
      if (seen.has(k)) return false;
      seen.add(k);
      return true;
    });
    if (tab !== 'all') {
      all = all.filter((a) => {
        const c = (a.category || '').toLowerCase();
        const t = `${a.title} ${a.summary}`.toLowerCase();
        if (tab === 'scams') return c === 'scams' || /scam|fraud|phish|telegram|fake|bvn|activation fee/.test(t);
        if (tab === 'money') return c === 'money' || /budget|naira|fee|bank|wallet|payment|fx|convert/.test(t);
        if (tab === 'skills') return c === 'guides' || c === 'opportunities' || /canva|tutor|freelance|ghostwrit|design|phone|client/.test(t);
        return true;
      });
    }
    total = all.length;
    articles = all.slice(offset, offset + perPage);
  } else {
    dbError = 'Database binding missing';
  }
} catch (e: any) {
  dbError = e?.message || 'Database error';
}
const totalPages = Math.max(1, Math.ceil(total / perPage));
const mid = Math.min(3, Math.max(1, articles.length - 1));
---
<Base
  title="LaneCash — Check the offer before you pay"
  description="Nigeria-first scam alerts, safe money habits, and practical phone skills. Educational only — not financial advice."
  canonical={cleanHome}
  noindex={isFilterView}
>
  <div class="disclaimer-banner">
    <strong>Disclaimer:</strong> Educational content only — not financial advice.
    <a href="/disclaimer">Read full disclaimer</a>
  </div>

  <section class="hero">
    <div class="hero-kicker">Nigeria · Scam defence · Money tools</div>
    <h1>Check the offer before you pay.</h1>
    <p>
      Clear guides on WhatsApp job traps, fake recruitment, naira money habits, and phone skills — without the “get rich” noise.
    </p>
  </section>

  <div class="tool-strip" aria-label="Quick tools">
    <a class="tool-card" href="/tools/currency">
      <strong>Currency</strong>
      <span>Any-to-any converter</span>
    </a>
    <a class="tool-card" href="/tools/usd-ngn">
      <strong>USD → NGN</strong>
      <span>Quick naira check</span>
    </a>
    <a class="tool-card" href="/?tab=scams" rel="nofollow">
      <strong>Scam alerts</strong>
      <span>Patterns to reject</span>
    </a>
    <a class="tool-card" href="/tools">
      <strong>All tools</strong>
      <span>Fees · calculators</span>
    </a>
  </div>

  <div class="chips">
    <a class={`chip ${tab==='all'?'active':''}`} href="/">★ Latest</a>
    <a class={`chip ${tab==='scams'?'active':''}`} href="/?tab=scams" rel="nofollow">Scam alerts</a>
    <a class={`chip ${tab==='money'?'active':''}`} href="/?tab=money" rel="nofollow">Money habits</a>
    <a class={`chip ${tab==='skills'?'active':''}`} href="/?tab=skills" rel="nofollow">Phone skills</a>
  </div>

  <BannerAd size="320x50" />

  <div class="section-head">
    <h2>{tab === 'scams' ? 'Scam alerts' : tab === 'money' ? 'Money habits' : tab === 'skills' ? 'Phone skills' : 'Latest guides'}</h2>
    <a href="/search">Search ›</a>
  </div>
  {dbError && <div class="empty">Temporary issue loading posts. Retry shortly.</div>}
  <section class="feed" id="feed">
    {articles.length ? articles.map((a, i) => (
      <>
        {i === mid && (
          <div class="mid-ad-wrap" style="max-height:280px;overflow:hidden;margin:8px 0">
            <BannerAd size="300x250" />
          </div>
        )}
        <a
          class="card"
          href={`/article/${a.slug}`}
          data-path={`/article/${a.slug}`}
          data-slug={a.slug}
          data-title={a.title}
          data-category={a.category}
          data-summary={a.summary}
        >
          <div class="card-main">
            <span class={`pill ${a.category}`}>{a.category}</span>
            <h3>{a.title}</h3>
            <p>{a.summary}</p>
            <div class="card-meta">
              <span>{a.author_team || teamFor(a.category, a.title)} · {a.reading_minutes || 8} min</span>
              <span class="save-inline" data-slug={a.slug}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 3h10a1 1 0 0 1 1 1v17l-6-3.5L6 21V4a1 1 0 0 1 1-1z"/></svg>
                Save
              </span>
            </div>
          </div>
          <img
            class="card-thumb"
            src={coverFor(a)}
            alt=""
            loading="lazy"
            width="110"
            height="110"
            data-fallback={svgCover(a)}
            onerror="this.onerror=null;this.src=this.getAttribute('data-fallback')||'/covers/fallback.svg'"
          />
        </a>
      </>
    )) : (!dbError && <div class="empty">No articles yet.</div>)}
  </section>
  <Pagination page={page} totalPages={totalPages} base={tab==='all' ? '/' : `/?tab=${tab}`} />
  <script is:inline>
    (function(){
      try {
        var interest = (window.LC && window.LC.get('lc_interest', {})) || {};
        document.querySelectorAll('.card').forEach(function(c){
          var path = c.getAttribute('data-path') || '';
          if ((interest[path] || 0) >= 2) c.classList.add('card-interest');
        });
      } catch (e) {}

      document.querySelectorAll('.card').forEach(function(c){
        c.addEventListener('click', function(){
          window.LC && window.LC.track(c.getAttribute('data-path'), 'open');
        });
      });
      document.querySelectorAll('.save-inline').forEach(function(btn){
        btn.addEventListener('click', function(e){
          e.preventDefault(); e.stopPropagation();
          var slug = btn.getAttribute('data-slug');
          var saved = window.LC.get('lc_saved', []);
          if (saved.indexOf(slug) < 0) {
            saved.unshift(slug);
            window.LC.set('lc_saved', saved.slice(0, 100));
            window.LC.toast('Saved');
            window.LC.beacon('save');
          } else window.LC.toast('Already saved');
        });
      });
    })();
  </script>
</Base>
