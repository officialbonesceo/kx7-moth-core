---
import Base from '../layouts/Base.astro';
import Pagination from '../components/Pagination.astro';
import { getArticles } from '../lib/db';
import { coverFor } from '../lib/images';
import { teamFor } from '../lib/socials';

export const prerender = false;

const db = Astro.locals.runtime?.env?.DB;
const tab = Astro.url.searchParams.get('tab') || 'all';
const page = Math.max(1, Number(Astro.url.searchParams.get('page') || 1));
const perPage = 10;
const offset = (page - 1) * perPage;

let articles: any[] = [];
let total = 0;
let dbError = '';

try {
  if (db) {
    const res = await getArticles(db, 120);
    let all = res.results || [];
    if (tab !== 'all') {
      all = all.filter((a) => {
        const c = (a.category || '').toLowerCase();
        const t = `${a.title} ${a.summary}`.toLowerCase();
        if (tab === 'crypto') return c === 'opportunities' || /crypto|usdt|bitcoin|token|airdrop|wallet|p2p/.test(t);
        if (tab === 'hustles') return c === 'guides' || /hustle|earn|freelance|side|content|tiktok|youtube|affiliate|drop/.test(t);
        if (tab === 'scams') return c === 'scams' || /scam|fraud|ponzi|phish|telegram/.test(t);
        if (tab === 'investing') return c === 'money' || /invest|budget|price|fee|bank|naira|payment/.test(t);
        return true;
      });
    }
    total = all.length;
    articles = all.slice(offset, offset + perPage);
  } else {
    dbError = 'Database binding missing';
  }
} catch (e: any) {
  dbError = e?.message || 'Database error';
}
const totalPages = Math.max(1, Math.ceil(total / perPage));
const showCryptoNews = tab === 'crypto' || tab === 'all';
---
<Base title="LaneCash — Stay Sharp. Get Ahead." description="Practical money skills: crypto safety, content systems, affiliate, dropshipping, scam alerts, and calculators.">
  <div class="disclaimer-banner">
    <strong>Disclaimer:</strong> Educational content only — not financial advice.
    <a href="/disclaimer">Read full disclaimer</a>
  </div>

  <section class="hero">
    <h1>Stay Sharp. Get Ahead.</h1>
    <p>Money skills, creator systems, crypto safety & scam alerts.</p>
  </section>
  <div class="chips">
    <a class={`chip ${tab==='all'?'active':''}`} href="/">★ For You</a>
    <a class={`chip ${tab==='crypto'?'active':''}`} href="/?tab=crypto">Crypto</a>
    <a class={`chip ${tab==='hustles'?'active':''}`} href="/?tab=hustles">Daily Hustles</a>
    <a class={`chip ${tab==='scams'?'active':''}`} href="/?tab=scams">Scam Alerts</a>
    <a class={`chip ${tab==='investing'?'active':''}`} href="/?tab=investing">Money</a>
  </div>

  {showCryptoNews && (
    <div class="calc-card" style="margin-bottom:12px">
      <div class="section-head" style="margin:0 0 8px">
        <h2 style="font-size:1rem">Crypto pulse</h2>
        <a href="/tools">Tools ›</a>
      </div>
      <div id="homeCryptoNews" class="muted" style="font-size:.85rem">Loading market headlines…</div>
    </div>
  )}

  <div class="section-head"><h2>Top Picks</h2><a href="/tools">Money tools ›</a></div>
  {dbError && <div class="empty">Temporary issue loading posts. Retry shortly.</div>}
  <section class="feed">
    {articles.length ? articles.map((a) => (
      <a class="card" href={`/article/${a.slug}`} data-path={`/article/${a.slug}`}>
        <div class="card-main">
          <span class={`pill ${a.category}`}>{a.category}</span>
          <h3>{a.title}</h3>
          <p>{a.summary}</p>
          <div class="card-meta">
            <span>{a.author_team || teamFor(a.category, a.title)} · {a.reading_minutes || 8} min</span>
            <span class="save-inline" data-slug={a.slug}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 3h10a1 1 0 0 1 1 1v17l-6-3.5L6 21V4a1 1 0 0 1 1-1z"/></svg>
              Save
            </span>
          </div>
        </div>
        <img class="card-thumb" src={coverFor(a)} alt="" loading="lazy" />
      </a>
    )) : (!dbError && <div class="empty">No articles yet.</div>)}
  </section>
  <Pagination page={page} totalPages={totalPages} base={tab==='all' ? '/' : `/?tab=${tab}`} />
  <script is:inline define:vars={{ showCryptoNews }}>
    document.querySelectorAll('.card').forEach(c=>c.addEventListener('click',()=>window.LC?.track(c.getAttribute('data-path'),'open')));
    document.querySelectorAll('.save-inline').forEach(btn=>btn.addEventListener('click',(e)=>{
      e.preventDefault(); e.stopPropagation();
      const slug=btn.getAttribute('data-slug'); const saved=window.LC.get('lc_saved',[]);
      if(!saved.includes(slug)){saved.unshift(slug); window.LC.set('lc_saved',saved.slice(0,100)); window.LC.toast('Saved');}
      else window.LC.toast('Already saved');
    }));
    if (showCryptoNews) {
      (async function(){
        var box = document.getElementById('homeCryptoNews');
        if (!box) return;
        try {
          var r = await fetch('/api/crypto/news');
          var j = await r.json();
          var items = (j.items || []).slice(0, 5);
          if (!items.length) { box.textContent = 'No headlines right now.'; return; }
          box.innerHTML = items.map(function(it){
            return '<div style="padding:8px 0;border-bottom:1px solid rgba(255,255,255,.06)">' +
              '<a href="' + (it.url||'#') + '" target="_blank" rel="noopener noreferrer" style="color:#fff;font-weight:700;font-size:.88rem">' + (it.title||'') + '</a>' +
              '<div class="muted" style="font-size:.72rem;margin-top:2px">' + (it.source||'') + '</div></div>';
          }).join('');
        } catch (e) {
          box.textContent = 'Headlines unavailable.';
        }
      })();
    }
  </script>
</Base>
