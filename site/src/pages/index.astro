---
import Base from '../layouts/Base.astro';
import { getArticles } from '../lib/db';

const db = Astro.locals.runtime?.env?.DB;
let articles: any[] = [];
if (db) {
  const res = await getArticles(db, 20);
  articles = res.results || [];
}
---
<Base title="LaneCash — Practical Money & Side Hustles">
  <section class="hero">
    <h1>Practical money. No hype.</h1>
    <p>Real side hustles, opportunity alerts, scam warnings, and clear guides for everyday people.</p>
  </section>

  <section class="grid">
    {articles.length ? articles.map((a) => (
      <a class="card" href={`/article/${a.slug}`}>
        <div class="eyebrow">{a.category}</div>
        <h2>{a.title}</h2>
        <p>{a.summary}</p>
      </a>
    )) : (
      <div class="empty">No articles yet. Run pulse-a to publish.</div>
    )}
  </section>
</Base>
