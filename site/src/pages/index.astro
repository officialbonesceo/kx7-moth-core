---
import Base from '../layouts/Base.astro';
import { getArticles } from '../lib/db';

const db = Astro.locals.runtime?.env?.DB;
let articles: any[] = [];
if (db) {
  const res = await getArticles(db, 24);
  articles = res.results || [];
}
const featured = articles[0];
const rest = articles.slice(1);

function cover(a: any) {
  if (a?.image_url) return a.image_url;
  const seed = encodeURIComponent(a?.slug || a?.id || 'finance');
  return `https://image.pollinations.ai/prompt/${encodeURIComponent((a?.category || 'finance') + ' money crypto editorial dark green')}?width=1200&height=675&nologo=true&seed=${seed}`;
}
---
<Base title="LaneCash — Finance, Crypto & Side Hustles">
  {featured ? (
    <section class="hero-card">
      <div class="hero-copy">
        <span class="pill">{featured.category || 'money'}</span>
        <h1>{featured.title}</h1>
        <p>{featured.summary}</p>
        <div class="hero-meta">
          <span>LaneCash Desk</span>
          <span>•</span>
          <span>{featured.reading_minutes || 5} min read</span>
        </div>
        <a class="btn" href={`/article/${featured.slug}`}>Read Article →</a>
      </div>
      <div class="hero-media">
        <img src={cover(featured)} alt={featured.title} />
      </div>
    </section>
  ) : (
    <div class="empty">No articles yet. Run pulse-a to publish.</div>
  )}

  <div class="section-head">
    <h2>Latest Articles</h2>
    <a href="/category/money">View all →</a>
  </div>

  <section class="grid">
    {rest.map((a) => (
      <a class="card" href={`/article/${a.slug}`}>
        <img class="card-img" src={cover(a)} alt={a.title} loading="lazy" />
        <div class="card-body">
          <span class={`pill ${a.category}`}>{a.category}</span>
          <h3>{a.title}</h3>
          <p>{a.summary}</p>
          <div class="card-foot">Read More →</div>
        </div>
      </a>
    ))}
  </section>
</Base>
