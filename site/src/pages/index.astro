---
import Base from '../layouts/Base.astro';
import Pagination from '../components/Pagination.astro';
import BannerAd from '../components/BannerAd.astro';
import { getArticles } from '../lib/db';
import { coverFor, svgCover } from '../lib/images';
import { teamFor } from '../lib/socials';

export const prerender = false;

const db = Astro.locals.runtime?.env?.DB;
const tab = Astro.url.searchParams.get('tab') || 'all';
const page = Math.max(1, Number(Astro.url.searchParams.get('page') || 1));
const perPage = 10;
const offset = (page - 1) * perPage;

const isFilterView = tab !== 'all' || page > 1;
const origin = Astro.url.origin;
const cleanHome = `${origin}/`;

function fmtTime(iso?: string) {
  if (!iso) return '';
  try {
    const d = new Date(iso.includes('T') ? iso : iso.replace(' ', 'T') + 'Z');
    if (Number.isNaN(d.getTime())) return String(iso).slice(0, 10);
    return d.toLocaleDateString('en-NG', { day: 'numeric', month: 'short', year: 'numeric' });
  } catch {
    return String(iso).slice(0, 10);
  }
}

let articles: any[] = [];
let total = 0;
let dbError = '';
let heroPool: any[] = [];

try {
  if (db) {
    const res = await getArticles(db, 120);
    let all = res.results || [];
    const seen = new Set<string>();
    all = all.filter((a) => {
      const k = String(a.title || '')
        .toLowerCase()
        .normalize('NFKC')
        .replace(/[\u2018\u2019]/g, "'")
        .replace(/[\u201c\u201d]/g, '"')
        .replace(/\s+/g, ' ')
        .trim();
      if (seen.has(k)) return false;
      seen.add(k);
      return true;
    });
    const featured = all.filter((a) => Number(a.is_featured) === 1).slice(0, 3);
    const byViews = [...all].sort((a, b) => Number(b.views || 0) - Number(a.views || 0));
    heroPool = (featured.length >= 3 ? featured : [...featured, ...byViews]).slice(0, 3);
    if (heroPool.length < 3) heroPool = all.slice(0, 3);

    if (tab !== 'all') {
      all = all.filter((a) => {
        const c = (a.category || '').toLowerCase();
        const t = `${a.title} ${a.summary}`.toLowerCase();
        if (tab === 'scams') return c === 'scams' || /scam|fraud|phish|telegram|fake|bvn|activation fee/.test(t);
        if (tab === 'money') return c === 'money' || /budget|naira|fee|bank|wallet|payment|fx|convert/.test(t);
        if (tab === 'skills') return c === 'guides' || c === 'opportunities' || /canva|tutor|freelance|ghostwrit|design|phone|client|student|job/.test(t);
        return true;
      });
    }
    total = all.length;
    articles = all.slice(offset, offset + perPage);
  } else {
    dbError = 'Database binding missing';
  }
} catch (e: any) {
  dbError = e?.message || 'Database error';
}
const totalPages = Math.max(1, Math.ceil(total / perPage));
const mid = Math.min(3, Math.max(1, articles.length - 1));
const showHero = page === 1 && tab === 'all' && heroPool.length > 0;
---
<Base
  title="LaneCash — Check the offer before you pay"
  description="Nigeria-first scam alerts, safe money habits, and practical phone skills for students and beginners. Educational only — not financial advice."
  canonical={cleanHome}
  noindex={isFilterView}
>
  <div class="disclaimer-banner">
    <strong>Disclaimer:</strong> Educational content only — not financial advice.
    <a href="/disclaimer">Full disclaimer</a>
  </div>

  {showHero && (
    <div class="hero-carousel" id="homeHero" aria-roledescription="carousel" aria-label="Featured guides">
      <div class="hero-track" id="homeHeroTrack">
        {heroPool.map((a) => (
          <div class="hero-slide" data-type="article" data-hold="4500">
            <a href={`/article/${a.slug}`}>
              <img
                class="hero-img"
                src={coverFor(a)}
                alt=""
                loading="eager"
                decoding="async"
                data-fallback={svgCover(a)}
                onerror="this.onerror=null;this.src=this.getAttribute('data-fallback')"
              />
              <div class="hero-grad"></div>
              <div class="hero-body">
                <span class={`hero-pill ${a.category || ''}`}>{a.category || 'guide'}</span>
                <h2>{a.title}</h2>
                <p>{a.summary}</p>
              </div>
            </a>
          </div>
        ))}
        <div class="hero-slide" data-type="ad" data-hold="7000">
          <div class="hero-ad-slide" aria-label="Sponsored">
            <BannerAd size="300x250" />
          </div>
        </div>
      </div>
      <button type="button" class="hero-nav prev" id="heroPrev" aria-label="Previous">‹</button>
      <button type="button" class="hero-nav next" id="heroNext" aria-label="Next">›</button>
      <div class="hero-dots" id="homeHeroDots"></div>
    </div>
  )}

  <div class="chips">
    <a class={`chip ${tab==='all'?'active':''}`} href="/">★ Latest</a>
    <a class={`chip ${tab==='scams'?'active':''}`} href="/?tab=scams" rel="nofollow">Scam alerts</a>
    <a class={`chip ${tab==='money'?'active':''}`} href="/?tab=money" rel="nofollow">Money habits</a>
    <a class={`chip ${tab==='skills'?'active':''}`} href="/?tab=skills" rel="nofollow">Phone skills</a>
  </div>

  <div class="section-head">
    <h2>{tab === 'scams' ? 'Scam alerts' : tab === 'money' ? 'Money habits' : tab === 'skills' ? 'Phone skills' : 'Latest guides'}</h2>
    <a href="/search">Search ›</a>
  </div>
  {dbError && <div class="empty">Temporary issue loading posts. Retry shortly.</div>}
  <section class="feed" id="feed">
    {articles.length ? articles.map((a, i) => (
      <>
        {i === mid && (
          <div class="mid-ad-wrap">
            <BannerAd size="300x250" />
          </div>
        )}
        <a
          class="card"
          href={`/article/${a.slug}`}
          data-path={`/article/${a.slug}`}
          data-slug={a.slug}
        >
          <div class="card-main">
            <span class={`pill ${a.category}`}>{a.category}</span>
            <h3>{a.title}</h3>
            <p>{a.summary}</p>
            <div class="card-meta">
              <span class="time-stamp">{fmtTime(a.published_at)} · {a.reading_minutes || 5} min</span>
              <span class="save-inline" data-slug={a.slug}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 3h10a1 1 0 0 1 1 1v17l-6-3.5L6 21V4a1 1 0 0 1 1-1z"/></svg>
                Save
              </span>
            </div>
          </div>
          <img
            class="card-thumb"
            src={coverFor(a)}
            alt=""
            loading="lazy"
            decoding="async"
            width="88"
            height="88"
            data-fallback={svgCover(a)}
            onerror="this.onerror=null;this.src=this.getAttribute('data-fallback')"
          />
        </a>
      </>
    )) : (!dbError && <div class="empty">No articles yet.</div>)}
  </section>
  <Pagination page={page} totalPages={totalPages} base={tab==='all' ? '/' : `/?tab=${tab}`} />

  <div class="tools-foot">
    <p><strong>Currency & fee tools</strong>Convert rates and estimate transfer costs on the Tools tab.</p>
    <a class="tools-cta" href="/tools">Open tools →</a>
  </div>

  <script is:inline>
    (function(){
      var root = document.getElementById('homeHero');
      if (root) {
        var track = document.getElementById('homeHeroTrack');
        var slides = track ? Array.prototype.slice.call(track.querySelectorAll('.hero-slide')) : [];
        var n = slides.length;
        var i = 0;
        var timer = null;
        var dots = document.getElementById('homeHeroDots');
        function holdMs(idx){
          var el = slides[idx];
          var h = el && el.getAttribute('data-hold');
          return h ? Number(h) : 4500;
        }
        function go(idx){
          if (!n) return;
          i = (idx + n) % n;
          track.style.transform = 'translate3d(' + (-i * 100) + '%,0,0)';
          if (dots) {
            var ds = dots.querySelectorAll('.hero-dot');
            ds.forEach(function(d, j){ d.classList.toggle('active', j === i); });
          }
          schedule();
        }
        function schedule(){
          if (timer) clearTimeout(timer);
          timer = setTimeout(function(){ go(i + 1); }, holdMs(i));
        }
        if (dots) {
          for (var d = 0; d < n; d++) {
            var b = document.createElement('button');
            b.type = 'button';
            b.className = 'hero-dot' + (d === 0 ? ' active' : '');
            b.setAttribute('aria-label', 'Slide ' + (d + 1));
            (function(idx){ b.addEventListener('click', function(){ go(idx); }); })(d);
            dots.appendChild(b);
          }
        }
        document.getElementById('heroNext')?.addEventListener('click', function(){ go(i + 1); });
        document.getElementById('heroPrev')?.addEventListener('click', function(){ go(i - 1); });
        var startX = 0, dx = 0;
        root.addEventListener('touchstart', function(e){
          startX = e.changedTouches[0].clientX; dx = 0;
          if (timer) clearTimeout(timer);
        }, {passive:true});
        root.addEventListener('touchmove', function(e){
          dx = e.changedTouches[0].clientX - startX;
        }, {passive:true});
        root.addEventListener('touchend', function(){
          if (Math.abs(dx) > 40) go(i + (dx < 0 ? 1 : -1));
          else schedule();
        });
        schedule();
        document.addEventListener('visibilitychange', function(){
          if (document.hidden) { if (timer) clearTimeout(timer); }
          else schedule();
        });
      }

      document.querySelectorAll('.card').forEach(function(c){
        c.addEventListener('click', function(){
          window.LC && window.LC.track(c.getAttribute('data-path'), 'open');
        });
      });
      document.querySelectorAll('.save-inline').forEach(function(btn){
        btn.addEventListener('click', function(e){
          e.preventDefault(); e.stopPropagation();
          var slug = btn.getAttribute('data-slug');
          var saved = window.LC.get('lc_saved', []);
          if (saved.indexOf(slug) < 0) {
            saved.unshift(slug);
            window.LC.set('lc_saved', saved.slice(0, 100));
            window.LC.toast('Saved');
            window.LC.beacon('save');
          } else window.LC.toast('Already saved');
        });
      });
    })();
  </script>
</Base>
