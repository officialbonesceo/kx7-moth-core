---
import Base from '../layouts/Base.astro';
---
<Base title="Alerts — LaneCash" noindex={true}>
  <section class="hero">
    <h1>Alerts</h1>
    <p>Enable device notifications for LaneCash updates.</p>
  </section>

  <div class="calc-card" style="margin-bottom:14px">
    <h3 style="margin:0 0 8px">Push notifications</h3>
    <p class="muted" style="margin:0 0 12px;line-height:1.5">
      Your browser will ask permission. Allow it to get alerts on this device.
    </p>
    <button class="save-btn calc-primary" id="pushBtn" type="button">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-3px;margin-right:6px"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10 21a2 2 0 0 0 4 0"/></svg>
      Enable notifications
    </button>
    <p class="muted" id="pushStatus" style="margin-top:12px;line-height:1.5"></p>
  </div>

  <div class="section-head"><h2>Based on what you open</h2></div>
  <div id="nlist" class="feed"></div>

  <script is:inline>
    (function(){
      function nice(p){ return String(p||'').replace('/article/','').replace(/-/g,' '); }
      var interest = window.LC.get('lc_interest', {}) || {};
      var top = Object.entries(interest).sort(function(a,b){return b[1]-a[1]}).slice(0,8);
      var box = document.getElementById('nlist');
      if (!top.length) {
        box.innerHTML = '<div class="empty">Open a few articles to personalize alerts.</div>';
      } else {
        box.innerHTML = top.map(function(row){
          return '<div class="card" style="grid-template-columns:1fr"><div class="card-main"><h3>' +
            nice(row[0]) + '</h3><p class="muted">Opened ' + row[1] + ' time(s)</p></div></div>';
        }).join('');
      }

      function urlBase64ToUint8Array(base64String){
        var padding = '='.repeat((4 - (base64String.length % 4)) % 4);
        var base64 = (base64String + padding).replace(/-/g,'+').replace(/_/g,'/');
        var raw = atob(base64);
        var out = new Uint8Array(raw.length);
        for (var i=0;i<raw.length;++i) out[i] = raw.charCodeAt(i);
        return out;
      }

      async function enablePush(){
        var status = document.getElementById('pushStatus');
        var btn = document.getElementById('pushBtn');
        btn.disabled = true;
        try {
          if (!window.isSecureContext) {
            status.textContent = 'Open the site over HTTPS to enable alerts.';
            return;
          }
          if (!('Notification' in window)) {
            status.textContent = 'This browser does not support notifications.';
            return;
          }
          if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
            status.textContent = 'Push is not supported here. Try Chrome or Edge.';
            return;
          }

          status.textContent = 'Registering service worker…';
          var reg = await navigator.serviceWorker.register('/sw.js');
          await navigator.serviceWorker.ready;

          status.textContent = 'Waiting for permission…';
          var perm = Notification.permission;
          if (perm === 'default') {
            perm = await Notification.requestPermission();
          }
          if (perm !== 'granted') {
            status.textContent = 'Permission denied. In browser site settings, allow Notifications for this site, then tap Enable again.';
            return;
          }

          status.textContent = 'Fetching server key…';
          var vapidRes = await fetch('/api/push/vapid-public');
          var vapid = await vapidRes.json();
          if (!vapid.publicKey) {
            status.textContent = 'Server VAPID key missing. Add VAPID_PUBLIC_KEY in Cloudflare env.';
            return;
          }

          status.textContent = 'Subscribing device…';
          var sub = await reg.pushManager.getSubscription();
          if (!sub) {
            sub = await reg.pushManager.subscribe({
              userVisibleOnly: true,
              applicationServerKey: urlBase64ToUint8Array(vapid.publicKey)
            });
          }

          var res = await fetch('/api/push/subscribe', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(sub.toJSON())
          });
          var j = await res.json();
          if (!j.ok) {
            status.textContent = 'Subscribe API failed. Check D1 push_subscriptions table.';
            return;
          }

          window.LC.set('lc_push', true);
          status.textContent = 'Alerts enabled on this device.';
          window.LC.toast('Alerts on');
          try {
            await reg.showNotification('LaneCash', {
              body: 'Notifications are working on this device.',
              icon: '/favicon.svg'
            });
          } catch (e) {}
        } catch (e) {
          status.textContent = 'Error: ' + (e && e.message ? e.message : 'could not enable');
          console.error(e);
        } finally {
          btn.disabled = false;
        }
      }

      document.getElementById('pushBtn').addEventListener('click', enablePush);
      if (window.LC.get('lc_push', false)) {
        document.getElementById('pushStatus').textContent = 'Alerts were enabled on this device before. Tap the button again if you reinstalled the browser.';
      }
    })();
  </script>
</Base>
