---
import Base from '../layouts/Base.astro';
import SocialBar from '../components/SocialBar.astro';
---
<Base title="Profile — LaneCash" description="Your LaneCash activity and alert preferences." noindex={true}>
  <section class="hero"><h1>Profile</h1><p>Your activity and alert preferences on this device.</p></section>

  <div class="calc-card" style="margin-bottom:12px">
    <h3>Your activity</h3>
    <p class="muted" id="statsLine">—</p>
    <p class="muted" id="interestLine">—</p>
  </div>

  <div class="calc-card" style="margin-bottom:12px">
    <h3>Notifications</h3>
    <p class="muted">Get LaneCash alerts on this phone when important updates drop.</p>
    <button class="save-btn" id="pushBtn" type="button">Enable alerts</button>
    <p class="muted" id="pushStatus" style="margin-top:10px;line-height:1.5"></p>
  </div>

  <SocialBar />

  <script is:inline>
    (function(){
      function friendlyPath(p){
        if (!p) return '';
        return String(p).replace('/article/', '').replace(/-/g, ' ').slice(0, 42);
      }
      function refresh(){
        var saved = (window.LC.get('lc_saved', []) || []).length;
        var events = (window.LC.get('lc_events', []) || []).length;
        var interest = window.LC.get('lc_interest', {}) || {};
        var top = Object.entries(interest).sort(function(a,b){return b[1]-a[1]}).slice(0,3)
          .map(function(x){return friendlyPath(x[0]) + ' (' + x[1] + ')'}).join(', ') || 'No reads yet';
        var s = document.getElementById('statsLine');
        var i = document.getElementById('interestLine');
        if (s) s.textContent = 'Saved: ' + saved + ' · Opens tracked: ' + events;
        if (i) i.textContent = 'Most opened: ' + top;
      }
      refresh();

      function urlBase64ToUint8Array(base64String){
        var padding = '='.repeat((4 - (base64String.length % 4)) % 4);
        var base64 = (base64String + padding).replace(/-/g,'+').replace(/_/g,'/');
        var raw = atob(base64);
        var out = new Uint8Array(raw.length);
        for (var i=0;i<raw.length;++i) out[i] = raw.charCodeAt(i);
        return out;
      }

      document.getElementById('pushBtn').addEventListener('click', async function(){
        var status = document.getElementById('pushStatus');
        var btn = document.getElementById('pushBtn');
        btn.disabled = true;
        try {
          if (!window.isSecureContext) { status.textContent = 'Open the secure LaneCash site to enable alerts.'; return; }
          if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
            status.textContent = 'Alerts are not supported on this browser. Try Chrome.'; return;
          }
          status.textContent = 'Setting up…';
          var reg = await navigator.serviceWorker.register('/sw.js');
          await navigator.serviceWorker.ready;

          var perm = await Notification.requestPermission();
          if (perm !== 'granted') {
            status.textContent = 'Permission blocked. Allow notifications for this site in browser settings, then try again.'; return;
          }

          var vapidRes = await fetch('/api/push/vapid-public');
          var vapid = await vapidRes.json();
          if (!vapid.publicKey) {
            status.textContent = 'Alerts are temporarily unavailable. Try again later.'; return;
          }

          var sub = await reg.pushManager.getSubscription();
          if (!sub) {
            sub = await reg.pushManager.subscribe({
              userVisibleOnly: true,
              applicationServerKey: urlBase64ToUint8Array(vapid.publicKey)
            });
          }
          var res = await fetch('/api/push/subscribe', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(sub.toJSON())
          });
          var j = await res.json();
          if (!j.ok) {
            status.textContent = 'Could not enable alerts right now. Please try again.'; return;
          }
          window.LC.set('lc_push', true);
          status.textContent = '✅ Alerts enabled on this device.';
          window.LC.toast('Alerts on');
          try { new Notification('LaneCash', { body: 'You will get important money updates here.' }); } catch(e) {}
          refresh();
        } catch (e) {
          status.textContent = 'Could not enable alerts. Please try again.';
        } finally {
          btn.disabled = false;
        }
      });

      if (window.LC.get('lc_push', false)) {
        document.getElementById('pushStatus').textContent = '✅ Alerts are enabled on this device.';
      }
    })();
  </script>
</Base>
