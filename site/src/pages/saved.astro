---
import Base from '../layouts/Base.astro';
---
<Base title="Saved — LaneCash" description="Your saved LaneCash guides." noindex={true}>
  <section class="hero"><h1>Saved</h1><p>Stored on this device.</p></section>
  <div id="savedList" class="feed"></div>
  <script is:inline>
    (function(){
      const box = document.getElementById('savedList');
      if (!box) return;
      const slugs = (window.LC && window.LC.get('lc_saved', [])) || [];
      if (!slugs.length) {
        box.innerHTML = '<div class="empty">No saved articles yet. Tap Save on any post.</div>';
        return;
      }
      const cache = (window.LC && window.LC.get('lc_article_cache', {})) || {};
      box.innerHTML = slugs.map(function(s){
        const c = cache[s] || {};
        const title = c.title || s.replace(/-/g,' ');
        const summary = c.summary || 'Open once to refresh title & summary.';
        const category = c.category || 'saved';
        return '<a class="card" href="/article/' + s + '" style="grid-template-columns:1fr">' +
          '<div class="card-main">' +
          '<span class="pill">' + category + '</span>' +
          '<h3>' + title + '</h3>' +
          '<p>' + summary + '</p>' +
          '</div></a>';
      }).join('');
    })();
  </script>
</Base>
