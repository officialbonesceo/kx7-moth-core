---
import Base from '../layouts/Base.astro';
---
<Base title="Saved — LaneCash">
  <section class="hero"><h1>Saved</h1><p>Articles you bookmarked on this device.</p></section>
  <div id="savedList" class="feed"><div class="empty">Loading…</div></div>
  <script is:inline>
    (async function(){
      const box=document.getElementById('savedList');
      const slugs=window.LC.get('lc_saved',[]);
      if(!slugs.length){ box.innerHTML='<div class="empty">No saved articles yet.</div>'; return; }
      // profile cache of titles
      const cache=window.LC.get('lc_article_cache', {});
      box.innerHTML=slugs.map(s=>{
        const c=cache[s]||{title:s, summary:'Open to refresh details', category:'saved'};
        return `<a class="card" href="/article/${s}"><div class="card-main"><span class="pill">${c.category||'saved'}</span><h3>${c.title||s}</h3><p>${c.summary||''}</p></div></a>`;
      }).join('');
    })();
  </script>
</Base>
