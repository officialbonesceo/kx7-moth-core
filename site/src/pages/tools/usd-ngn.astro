---
import Base from '../../layouts/Base.astro';

const origin = Astro.url.origin;
const pageUrl = `${origin}/tools/usd-ngn`;

const POPULAR = [
  'USD', 'NGN', 'EUR', 'GBP', 'KWD', 'AED', 'SAR', 'QAR', 'BHD', 'OMR',
  'CAD', 'AUD', 'CHF', 'JPY', 'CNY', 'INR', 'GHS', 'KES', 'ZAR', 'TRY', 'EGP',
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Currency Converter — LaneCash',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Any',
    url: pageUrl,
    description:
      'Free any-to-any currency converter including USD, NGN, KWD, EUR, GBP and more. Mid-market estimates only — not CBN official rates or financial advice.',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'NGN' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Can I convert Kuwaiti Dinar (KWD) to Naira?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. Choose KWD as the from currency and NGN as the to currency. The rate is a public mid-market style estimate, not a bank quote.',
        },
      },
      {
        '@type': 'Question',
        name: 'Is this the official CBN USD to NGN rate?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No. LaneCash shows educational mid-market estimates from public feeds. For official reference rates, check the Central Bank of Nigeria.',
        },
      },
      {
        '@type': 'Question',
        name: 'Which currencies are supported?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Major world currencies available in the public rate table, including USD, NGN, EUR, GBP, KWD, AED, SAR and many others. Availability depends on the upstream feed.',
        },
      },
    ],
  },
];
---

<Base
  title="Currency Converter — USD, NGN, KWD & More | LaneCash"
  description="Convert any currency to any currency: USD to NGN, KWD to Naira, EUR, GBP and more. Free educational mid-market estimates. Not financial advice."
  jsonLd={jsonLd}
>
  <div class="disclaimer-banner">
    <strong>Disclaimer:</strong> Mid-market style estimates only — not CBN official, not a send-money quote, not financial advice.
    <a href="/disclaimer">Full disclaimer</a>
  </div>

  <article class="hero" style="max-width:720px">
    <p class="muted" style="margin:0 0 8px;font-size:.8rem">
      <a href="/tools">← Money tools</a>
    </p>
    <h1>Currency converter</h1>
    <p>
      Convert <strong>any to any</strong> — USD, Nigerian Naira (NGN), Kuwaiti Dinar (KWD), EUR, GBP, AED, and more.
      Rates are public estimates for education, not bank or bureau prices.
    </p>
  </article>

  <section class="calc-card" style="max-width:720px;margin:0 auto 24px" aria-labelledby="fx-heading">
    <h2 id="fx-heading" style="margin-top:0;font-size:1.1rem">Convert</h2>

    <div class="fx-rate-box" style="padding:14px 16px;border-radius:12px;background:var(--card-bg, rgba(0,0,0,.04));margin-bottom:14px">
      <div class="muted" style="font-size:.75rem;margin-bottom:4px">Estimated rate</div>
      <div id="fxHeadline" style="font-size:1.25rem;font-weight:700">—</div>
      <div id="fxMeta" class="muted" style="font-size:.75rem;margin-top:6px">Loading rates…</div>
    </div>

    <label for="fxAmount">Amount</label>
    <input id="fxAmount" type="number" inputmode="decimal" value="1" min="0" step="any" />

    <div style="display:grid;grid-template-columns:1fr auto 1fr;gap:10px;align-items:end;margin-top:12px">
      <div>
        <label for="fxFrom">From</label>
        <select id="fxFrom">
          {POPULAR.map((c) => (
            <option value={c} selected={c === 'USD'}>{c}</option>
          ))}
        </select>
      </div>
      <button type="button" id="fxSwap" class="chip" style="margin-bottom:4px" title="Swap" aria-label="Swap currencies">⇄</button>
      <div>
        <label for="fxTo">To</label>
        <select id="fxTo">
          {POPULAR.map((c) => (
            <option value={c} selected={c === 'NGN'}>{c}</option>
          ))}
        </select>
      </div>
    </div>

    <div style="display:flex;gap:8px;flex-wrap:wrap;margin:12px 0">
      <button type="button" class="chip" data-pair="USD,NGN">USD→NGN</button>
      <button type="button" class="chip" data-pair="KWD,NGN">KWD→NGN</button>
      <button type="button" class="chip" data-pair="EUR,NGN">EUR→NGN</button>
      <button type="button" class="chip" data-pair="GBP,NGN">GBP→NGN</button>
      <button type="button" class="chip" data-pair="AED,NGN">AED→NGN</button>
      <button type="button" class="chip" data-pair="NGN,USD">NGN→USD</button>
    </div>

    <button class="save-btn calc-primary" id="fxBtn" type="button">Convert</button>
    <div class="calc-result" id="fxOut" style="margin-top:12px">—</div>

    <p class="muted" style="font-size:.8rem;line-height:1.5;margin-top:14px">
      Official Nigeria reference:
      <a href="https://www.cbn.gov.ng/rates/ExchRateByCurrency" rel="noopener noreferrer" target="_blank">CBN exchange rates</a>.
      Parallel/street rates are not shown here.
    </p>
  </section>

  <section style="max-width:720px;margin:0 auto 32px">
    <h2 style="font-size:1.15rem">Supported pairs</h2>
    <p style="font-size:.95rem;line-height:1.55">
      Any currency in the list to any other, including <strong>KWD</strong> (Kuwait),
      <strong>AED</strong>, <strong>SAR</strong>, <strong>USD</strong>, <strong>NGN</strong>,
      <strong>EUR</strong>, <strong>GBP</strong>, and others returned by the public rate feed.
      The full dropdown may expand after rates load.
    </p>
    <h2 style="font-size:1.15rem">How caching works</h2>
    <p style="font-size:.95rem;line-height:1.55">
      Rate tables are cached on the server for a few minutes so the tool stays fast and does not hammer free APIs.
      Refresh for a newer estimate when markets move.
    </p>
    <p style="font-size:.95rem;line-height:1.55">
      More tools: <a href="/tools">LaneCash money tools</a>.
    </p>
  </section>

  <script is:inline>
    (function () {
      var origin = window.location.origin;
      var last = null;

      function money(n, code) {
        var x = Number(n);
        if (!isFinite(x)) return '—';
        var max = x >= 100 ? 2 : x >= 1 ? 4 : 6;
        return x.toLocaleString(undefined, { maximumFractionDigits: max }) + ' ' + code;
      }

      function fillSelect(sel, codes, current) {
        var v = current || sel.value;
        sel.innerHTML = codes
          .map(function (c) {
            return '<option value="' + c + '"' + (c === v ? ' selected' : '') + '>' + c + '</option>';
          })
          .join('');
      }

      async function convert() {
        var amount = +document.getElementById('fxAmount').value || 0;
        var from = document.getElementById('fxFrom').value;
        var to = document.getElementById('fxTo').value;
        var head = document.getElementById('fxHeadline');
        var meta = document.getElementById('fxMeta');
        var out = document.getElementById('fxOut');
        out.textContent = 'Converting…';
        try {
          var r = await fetch(
            origin +
              '/api/fx/convert?from=' +
              encodeURIComponent(from) +
              '&to=' +
              encodeURIComponent(to) +
              '&amount=' +
              encodeURIComponent(amount)
          );
          var j = await r.json();
          if (j.error) {
            head.textContent = '—';
            meta.textContent = j.error === 'pair_unavailable' ? 'Pair not in feed' : 'Rates unavailable';
            out.textContent = 'Try another pair';
            return;
          }
          last = j;
          head.textContent = '1 ' + j.from + ' ≈ ' + money(j.rate, j.to);
          meta.textContent =
            'Source: ' +
            (j.source || 'public') +
            (j.date ? ' · ' + j.date : '') +
            (j.cached ? ' · cached' : '') +
            ' · educational estimate';
          out.textContent = money(j.amount, j.from) + ' ≈ ' + money(j.result, j.to);

          if (j.popular && j.popular.length) {
            var extra = j.popular.slice();
            fillSelect(document.getElementById('fxFrom'), extra, j.from);
            fillSelect(document.getElementById('fxTo'), extra, j.to);
          }
        } catch (e) {
          head.textContent = '—';
          meta.textContent = 'Could not load rates';
          out.textContent = 'Try again shortly';
        }
      }

      document.getElementById('fxBtn').onclick = convert;
      document.getElementById('fxSwap').onclick = function () {
        var a = document.getElementById('fxFrom');
        var b = document.getElementById('fxTo');
        var t = a.value;
        a.value = b.value;
        b.value = t;
        convert();
      };
      document.querySelectorAll('[data-pair]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var p = btn.getAttribute('data-pair').split(',');
          document.getElementById('fxFrom').value = p[0];
          document.getElementById('fxTo').value = p[1];
          convert();
        });
      });
      document.getElementById('fxAmount').addEventListener('change', convert);
      document.getElementById('fxFrom').addEventListener('change', convert);
      document.getElementById('fxTo').addEventListener('change', convert);

      convert();
    })();
  </script>
</Base>
